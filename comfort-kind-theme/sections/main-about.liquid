    {
      "type": "image_picker",
      "id": "portrait_image",
      "label": "Portrait image"
    },
    {
      "type": "image_picker",
      "id": "story_image",
      "label": "Story image break"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
