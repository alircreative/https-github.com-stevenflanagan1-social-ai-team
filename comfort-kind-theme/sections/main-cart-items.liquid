{% comment %} Cart items section {% endcomment %}
<div class="ck-cart">
  <div class="ck-cart__inner">
    <h1 class="ck-cart__title">Your Cart</h1>

    {%- if cart.item_count == 0 -%}
      <div class="ck-cart__empty">
        <p>Your cart is empty.</p>
        <a href="{{ routes.root_url }}" class="ck-product__atc-btn" style="display:inline-flex;width:auto;padding:0 2rem;text-decoration:none;">Continue shopping</a>
      </div>
    {%- else -%}
      <table class="ck-cart__table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          {%- for item in cart.items -%}
            <tr class="ck-cart__item">
              <td class="ck-cart__item-info">
                <a href="{{ item.url }}">
                  {{ item.image | image_url: width: 80 | image_tag: loading: 'lazy', class: 'ck-cart__item-img' }}
                </a>
                <div>
                  <a href="{{ item.url }}" class="ck-cart__item-title">{{ item.product.title }}</a>
                  {%- unless item.product.has_only_default_variant -%}
                    <p class="ck-cart__item-variant">{{ item.variant.title }}</p>
                  {%- endunless -%}
                  <a href="{{ item.url_to_remove }}" class="ck-cart__item-remove">Remove</a>
                </div>
              </td>
              <td>
                <input type="number" value="{{ item.quantity }}" min="0"
                  data-line="{{ forloop.index }}"
                  class="ck-product__quantity-input ck-cart__qty"
                  style="width:60px;">
              </td>
              <td class="ck-cart__item-price">{{ item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- endif -%}
  </div>
</div>

<style>
.ck-cart { max-width: 860px; margin: 0 auto; padding: 4rem 2rem 2rem; }
.ck-cart__title { font-family: var(--font-heading); font-size: clamp(2rem, 4vw, 3rem); font-weight: 400; margin-bottom: 2rem; }
.ck-cart__empty { text-align: center; padding: 4rem 0; display: flex; flex-direction: column; align-items: center; gap: 1.5rem; }
.ck-cart__table { width: 100%; border-collapse: collapse; }
.ck-cart__table th { font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ck-tan); font-weight: 600; padding: 0.75rem 0; border-bottom: 1px solid var(--ck-border); text-align: left; }
.ck-cart__item td { padding: 1.5rem 0; border-bottom: 1px solid var(--ck-border); vertical-align: middle; }
.ck-cart__item-info { display: flex; gap: 1rem; align-items: flex-start; }
.ck-cart__item-img { width: 80px; height: 80px; object-fit: cover; border-radius: var(--radius-sm); }
.ck-cart__item-title { font-weight: 500; text-decoration: none; color: var(--ck-brown-dark); display: block; margin-bottom: 0.25rem; }
.ck-cart__item-variant { font-size: 13px; color: var(--ck-tan); margin: 0 0 0.5rem; }
.ck-cart__item-remove { font-size: 12px; color: var(--ck-tan); text-decoration: underline; }
.ck-cart__item-price { font-weight: 500; text-align: right; }
</style>

{% schema %}
{
  "name": "Cart Items",
  "settings": [],
  "presets": [{ "name": "Cart Items" }]
}
{% endschema %}
