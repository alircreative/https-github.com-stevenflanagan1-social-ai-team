<section class="ck-newsletter">
  <div class="ck-newsletter__inner">
    {% if section.settings.eyebrow != blank %}
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="ck-newsletter__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.body != blank %}
      <p class="ck-newsletter__body">{{ section.settings.body }}</p>
    {% endif %}

    {% form 'customer' %}
      <div class="ck-newsletter__form">
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input
          class="ck-newsletter__input"
          type="email"
          name="contact[email]"
          placeholder="your@email.com"
          required
          aria-label="Email address"
        >
        <button type="submit" class="ck-newsletter__submit">Join &rarr;</button>
      </div>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter Signup",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Letters from Ali"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A short note, once a month."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "New pieces, the people wearing them, what I'm thinking about. No noise, no urgency - you can leave whenever you like."
    }
  ],
  "presets": [
    {
      "name": "Newsletter Signup"
    }
  ]
}
{% endschema %}
