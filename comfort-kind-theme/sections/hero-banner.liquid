{% comment %} Hero Banner section — placeholder until full design is added {% endcomment %}
<section class="ck-hero">
  {%- if section.settings.image != blank -%}
    <div class="ck-hero__media">
      {{ section.settings.image | image_url: width: 1500 | image_tag: loading: 'eager', class: 'ck-hero__image' }}
    </div>
  {%- endif -%}
  <div class="ck-hero__content">
    {%- if section.settings.heading != blank -%}
      <h1 class="ck-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="ck-hero__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_url }}" class="ck-product__atc-btn" style="display:inline-flex;width:auto;padding:0 2rem;text-decoration:none;">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</section>

<style>
.ck-hero { position: relative; min-height: 80vh; display: flex; align-items: center; justify-content: center; background: var(--ck-cream); overflow: hidden; }
.ck-hero__media { position: absolute; inset: 0; }
.ck-hero__image { width: 100%; height: 100%; object-fit: cover; }
.ck-hero__content { position: relative; text-align: center; padding: 2rem; max-width: 600px; }
.ck-hero__heading { font-family: var(--font-heading); font-size: clamp(2.5rem, 6vw, 5rem); font-weight: 400; color: var(--ck-brown-dark); margin-bottom: 1rem; }
.ck-hero__subheading { font-size: 1.1rem; color: var(--ck-brown-mid); margin-bottom: 2rem; }
</style>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Comfort for hard days." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Heavyweight fleece. Organic cotton. Made to feel like a hug." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_url", "label": "Button URL" }
  ],
  "presets": [{ "name": "Hero Banner" }]
}
{% endschema %}
