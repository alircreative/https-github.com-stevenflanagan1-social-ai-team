{% comment %} Comfort Kind — Founder Hero Section {% endcomment %}

<section class="ck-hero">
  <div class="ck-hero__inner">

    <div class="ck-hero__content">
      <p class="ck-hero__eyebrow">
        {{ section.settings.eyebrow }}
      </p>

      <h1 class="ck-hero__heading">
        {{ section.settings.heading_plain | default: 'I made this in a' }}
        <em class="ck-hero__heading-accent">{{ section.settings.heading_italic | default: 'waiting room.' }}</em>
      </h1>

      {%- if section.settings.subheading != blank -%}
        <p class="ck-hero__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <p class="ck-hero__body">{{ section.settings.body }}</p>
      {%- endif -%}

      <div class="ck-hero__ctas">
        {%- if section.settings.button_primary_label != blank -%}
          <a href="{{ section.settings.button_primary_url }}" class="ck-btn ck-btn--outline">
            {{ section.settings.button_primary_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.button_secondary_label != blank -%}
          <a href="{{ section.settings.button_secondary_url }}" class="ck-btn ck-btn--outline">
            {{ section.settings.button_secondary_label }}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.image != blank -%}
      <div class="ck-hero__media">
        {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'eager', class: 'ck-hero__image' }}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Hi, I'm Ali - Founder" },
    { "type": "text", "id": "heading_plain", "label": "Heading (plain part)", "default": "I made this in a" },
    { "type": "text", "id": "heading_italic", "label": "Heading (italic accent)", "default": "waiting room." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Not literally - but that's where the idea was born." },
    { "type": "textarea", "id": "body", "label": "Body text", "default": "My son was diagnosed with a heart condition. The hospital was cold. I reached for something soft. Something steady. 8.9 oz organic cotton fleece, brushed soft inside. A small heart at the chest. Soft Strength stitched down the left sleeve. It didn't exist. So I made it." },
    { "type": "text", "id": "button_primary_label", "label": "Primary button label", "default": "Shop the Hoodie" },
    { "type": "url", "id": "button_primary_url", "label": "Primary button URL" },
    { "type": "text", "id": "button_secondary_label", "label": "Secondary button label", "default": "Read Our Story" },
    { "type": "url", "id": "button_secondary_url", "label": "Secondary button URL" },
    { "type": "image_picker", "id": "image", "label": "Hero image (optional)" }
  ],
  "presets": [{ "name": "Hero Banner" }]
}
{% endschema %}
