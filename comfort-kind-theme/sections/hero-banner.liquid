<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">

<section class="ck-hero-split">
  <div class="ck-hero-split__content">
    {% if section.settings.eyebrow != blank %}
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}

    <h1 class="ck-hero-split__heading">
      {{ section.settings.heading_plain }}
      {% if section.settings.heading_italic != blank %}
        <em>{{ section.settings.heading_italic }}</em>
      {% endif %}
    </h1>

    {% if section.settings.body != blank %}
      <p class="ck-hero-split__body">{{ section.settings.body }}</p>
    {% endif %}

    <div class="ck-hero-split__ctas">
      {% if section.settings.cta_primary_label != blank %}
        <a href="{{ section.settings.cta_primary_url }}" class="ck-btn ck-btn--primary">
          {{ section.settings.cta_primary_label }}
        </a>
      {% endif %}
      {% if section.settings.cta_secondary_label != blank %}
        <a href="{{ section.settings.cta_secondary_url }}" class="ck-btn ck-btn--secondary">
          {{ section.settings.cta_secondary_label }}
        </a>
      {% endif %}
    </div>

    {% if section.settings.trust_text != blank %}
      <p class="ck-hero-split__trust">{{ section.settings.trust_text }}</p>
    {% endif %}
  </div>

  <div class="ck-hero-split__image-col">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.image.alt }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'ck-hero-split__placeholder' }}
    {% endif %}
    {% if section.settings.caption != blank %}
      <span class="ck-hero-split__caption">{{ section.settings.caption }}</span>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero Split",
  "tag": "section",
  "class": "ck-section-hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Hi, I'm Ali · Founder"
    },
    {
      "type": "text",
      "id": "heading_plain",
      "label": "Heading (plain)",
      "default": "I made this in a waiting room."
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading (italic, appended)",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Not literally - but that's where the idea was born. My son was diagnosed with a heart condition. The hospital was cold. I reached for something soft. Something steady. 8.9 oz organic cotton fleece, brushed soft inside. A small heart at the chest. 'Soft Strength' stitched down the left sleeve. It didn't exist. So I made it."
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary CTA label",
      "default": "Shop the Hoodie - $72"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary CTA URL"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary CTA label",
      "default": "Read Our Story"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary CTA URL"
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Trust line",
      "default": "30-Day Comfort Guarantee - If it doesn't feel right, I'll make it right."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Image caption",
      "default": "Wearing / The Soft Strength Hoodie / Cream - Soft Strength on the left sleeve"
    }
  ],
  "presets": [
    {
      "name": "Hero Split"
    }
  ]
}
{% endschema %}
