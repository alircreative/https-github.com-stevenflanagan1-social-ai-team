{%- liquid
  assign featured_product = all_products[section.settings.product]
  assign current_variant = featured_product.selected_or_first_available_variant
-%}

<section class="ck-spotlight">
  <div class="img" style="{%- if featured_product.featured_image != blank -%}background-image:url('{{ featured_product.featured_image | image_url: width: 900 }}');{%- elsif section.settings.product_image != blank -%}background-image:url('{{ section.settings.product_image | image_url: width: 900 }}');{%- endif -%}">
    {%- if featured_product.featured_image == blank and section.settings.product_image == blank -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>
  <div class="info">
    {%- if section.settings.eyebrow != blank -%}
      <div class="eyebrow">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    <h2>
      {%- if featured_product != blank -%}{{ featured_product.title }}{%- else -%}{{ section.settings.product_name }}{%- endif -%}
    </h2>
    <div class="price">
      {%- if current_variant != blank -%}{{ current_variant.price | money }}{%- else -%}{{ section.settings.price }}{%- endif -%}
    </div>
    {%- if section.settings.body != blank -%}
      <p class="desc">{{ section.settings.body }}</p>
    {%- endif -%}
    {%- if section.settings.features != blank -%}
      <div class="details">
        {%- assign feature_lines = section.settings.features | split: "|" -%}
        {%- for line in feature_lines -%}
          {%- assign trimmed = line | strip -%}
          {%- if trimmed != blank -%}
            <div class="detail-row"><span class="dot">·</span><span>{{ trimmed }}</span></div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
    <div style="display:flex;gap:14px;flex-wrap:wrap;">
      {%- if featured_product != blank -%}
        {%- form 'product', featured_product, id: 'spotlight-product-form' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
          <button type="submit" name="add" class="ck-btn ck-btn--primary">Add to Bag</button>
        {%- endform -%}
      {%- else -%}
        <a href="{{ section.settings.cta_primary_url }}" class="ck-btn ck-btn--primary">{{ section.settings.cta_primary_label | default: 'Add to Bag' }}</a>
      {%- endif -%}
      <a href="/pages/give-comfort" class="ck-btn ck-btn--secondary">Send as a Gift</a>
    </div>
  </div>
</section>

<section class="ck-material">
  {%- assign callouts = section.blocks | where: 'type', 'detail_callout' -%}
  {%- assign specs = section.blocks | where: 'type', 'spec_row' -%}
  {%- for block in callouts -%}
    {%- assign idx = forloop.index0 -%}
    {%- assign is_even = idx | modulo: 2 -%}
    {%- if is_even == 0 -%}
      <div class="ck-mat-cell ck-mat-img" style="{%- if block.settings.image != blank -%}background-image:url('{{ block.settings.image | image_url: width: 800 }}');{%- endif -%}" {{ block.shopify_attributes }}></div>
      <div class="ck-mat-cell ck-mat-text">
        {%- if block.settings.eyebrow != blank -%}<div class="eyebrow">{{ block.settings.eyebrow }}</div>{%- endif -%}
        {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading | replace: ' / ', '<br>' }}</h3>{%- endif -%}
        {%- if block.settings.body != blank -%}<p>{{ block.settings.body }}</p>{%- endif -%}
        {%- if forloop.last and specs.size > 0 -%}
          <div class="ck-mat-specs">
            {%- for spec in specs -%}
              <div {{ spec.shopify_attributes }}>
                <div class="ck-mat-spec-label">{{ spec.settings.label }}</div>
                <div class="ck-mat-spec-val">{{ spec.settings.value }}</div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="ck-mat-cell ck-mat-text" {{ block.shopify_attributes }}>
        {%- if block.settings.eyebrow != blank -%}<div class="eyebrow">{{ block.settings.eyebrow }}</div>{%- endif -%}
        {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading | replace: ' / ', '<br>' }}</h3>{%- endif -%}
        {%- if block.settings.body != blank -%}<p>{{ block.settings.body }}</p>{%- endif -%}
      </div>
      <div class="ck-mat-cell ck-mat-img" style="{%- if block.settings.image != blank -%}background-image:url('{{ block.settings.image | image_url: width: 800 }}');{%- endif -%}"></div>
    {%- endif -%}
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Featured Product Hero",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Hero Piece"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "product_name",
      "label": "Product name (fallback)",
      "default": "The Soft Strength Hoodie"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price (fallback)",
      "default": "$72"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Description",
      "default": "8.9 oz organic cotton fleece. A super soft brushed lining inside. A small embroidered heart at the chest, and 'Soft Strength' in white thread on the left sleeve."
    },
    {
      "type": "textarea",
      "id": "features",
      "label": "Feature list (pipe-separated)",
      "default": "8.9 oz organic cotton fleece, super soft inside|'Soft Strength' embroidered on the left sleeve in white thread|Embroidered heart detail, left chest|Waist-length with dropped shoulders - ribbed cuffs, collar and hem|GOTS certified organic cotton - 30-day comfort guarantee"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image (fallback)"
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary CTA label",
      "default": "Add to Bag"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary CTA URL"
    }
  ],
  "blocks": [
    {
      "type": "detail_callout",
      "name": "Detail Callout",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading (use / for line break)"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "spec_row",
      "name": "Spec Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Product Hero",
      "blocks": [
        {
          "type": "detail_callout",
          "settings": {
            "eyebrow": "01 - Embroidered heart",
            "heading": "A small mark / near yours.",
            "body": "A small embroidered heart at the left chest. The quiet knowing that you're not the only one holding it all together."
          }
        },
        {
          "type": "detail_callout",
          "settings": {
            "eyebrow": "02 - Sleeve",
            "heading": "Soft strength / on the left sleeve.",
            "body": "'Soft Strength' embroidered in white thread on the left sleeve. Intentional. Not decorative. Something you notice when you need to."
          }
        },
        {
          "type": "detail_callout",
          "settings": {
            "eyebrow": "03 - Fabric",
            "heading": "8.9oz. Heavyweight, / intentionally.",
            "body": "GOTS certified organic cotton fleece. Substantial in your hands. Super soft brushed lining inside. Made to be felt, not just worn."
          }
        },
        {
          "type": "spec_row",
          "settings": {
            "label": "Fabric",
            "value": "8.9 oz organic fleece"
          }
        },
        {
          "type": "spec_row",
          "settings": {
            "label": "Lining",
            "value": "Brushed fleece inside"
          }
        },
        {
          "type": "spec_row",
          "settings": {
            "label": "Certification",
            "value": "GOTS certified organic"
          }
        },
        {
          "type": "spec_row",
          "settings": {
            "label": "Construction",
            "value": "Dropped shoulder, ribbed cuffs"
          }
        }
      ]
    }
  ]
}
{% endschema %}
