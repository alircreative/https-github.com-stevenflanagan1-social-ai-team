{%- liquid
  assign featured_product = all_products[section.settings.product_url]
  assign current_variant = featured_product.selected_or_first_available_variant
-%}

<section class="ck-spotlight">
  <div class="ck-spotlight__inner">
    <div class="ck-spotlight__info">
      {% if section.settings.eyebrow != blank %}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}

      <h2 class="ck-spotlight__heading">
        {% if featured_product != blank %}
          {{ featured_product.title }}
        {% else %}
          {{ section.settings.product_name }}
        {% endif %}
      </h2>

      <p class="ck-spotlight__price">
        {% if current_variant != blank %}
          {{ current_variant.price | money }}
        {% elsif section.settings.price != blank %}
          {{ section.settings.price }}
        {% endif %}
      </p>

      {% if section.settings.body != blank %}
        <p class="ck-spotlight__body">{{ section.settings.body }}</p>
      {% endif %}

      {% if section.settings.features != blank %}
        <ul class="ck-details">
          {%- assign feature_lines = section.settings.features | split: "\n" -%}
          {%- for line in feature_lines -%}
            {%- if line != blank -%}
              <li class="ck-details__item">{{ line | strip }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {% endif %}

      <div class="ck-spotlight__ctas">
        {% if featured_product != blank %}
          {%- form 'product', featured_product, id: 'spotlight-product-form' -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
            <button type="submit" name="add" class="ck-btn ck-btn--primary">
              Add to Bag
            </button>
          {%- endform -%}
        {% else %}
          <a href="{{ section.settings.cta_primary_url }}" class="ck-btn ck-btn--primary">
            {{ section.settings.cta_primary_label | default: 'Add to Bag' }}
          </a>
        {% endif %}
        <a href="/pages/give-comfort" class="ck-btn ck-btn--secondary">Send as a Gift</a>
      </div>
    </div>

    <div class="ck-spotlight__image-col">
      {% if featured_product.featured_image != blank %}
        {{ featured_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: featured_product.featured_image.alt }}
      {% elsif section.settings.product_image != blank %}
        {{ section.settings.product_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.product_image.alt }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag }}
      {% endif %}
      {% if section.settings.image_caption != blank %}
        <span class="ck-spotlight__caption">{{ section.settings.image_caption }}</span>
      {% endif %}
    </div>
  </div>
</section>

<div class="ck-material">
  {% for block in section.blocks %}
    {% if block.type == 'detail_callout' %}
      {%- assign is_reversed = forloop.index0 | modulo: 2 -%}
      <div class="ck-mat-cell{% if is_reversed == 1 %} ck-mat-cell--reversed{% endif %}" {{ block.shopify_attributes }}>
        <div class="ck-mat-cell__image">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.image.alt }}
          {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag }}
          {% endif %}
        </div>
        <div class="ck-mat-cell__text">
          {% if block.settings.eyebrow != blank %}
            <span class="ck-mat-cell__eyebrow">{{ block.settings.eyebrow }}</span>
          {% endif %}
          {% if block.settings.heading != blank %}
            <h3 class="ck-mat-cell__heading">{{ block.settings.heading | replace: ' / ', '<br>' }}</h3>
          {% endif %}
          {% if block.settings.body != blank %}
            <p class="ck-mat-cell__body">{{ block.settings.body }}</p>
          {% endif %}
        </div>
      </div>
    {% endif %}
  {% endfor %}
</div>

<div class="ck-mat-specs">
  {% for block in section.blocks %}
    {% if block.type == 'spec_row' %}
      <div class="ck-mat-specs__row" {{ block.shopify_attributes }}>
        <span class="ck-mat-spec-label">{{ block.settings.label }}</span>
        <span class="ck-mat-spec-val">{{ block.settings.value }}</span>
      </div>
    {% endif %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "Featured Product Hero",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Hero Piece"
    },
    {
      "type": "product",
      "id": "product_url",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "product_name",
      "label": "Product name (fallback)",
      "default": "The Soft Strength Hoodie"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price (fallback)",
      "default": "$72"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Description",
      "default": "8.9 oz organic cotton fleece. A super soft brushed lining inside. A small embroidered heart at the chest, and 'Soft Strength' in white thread on the left sleeve."
    },
    {
      "type": "textarea",
      "id": "features",
      "label": "Feature list (one per line)",
      "default": "8.9 oz organic cotton fleece, super soft inside\n'Soft Strength' embroidered on the left sleeve in white thread\nEmbroidered heart detail, left chest\nWaist-length with dropped shoulders - ribbed cuffs, collar and hem\nGOTS certified organic cotton - 30-day comfort guarantee"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image (if no Shopify product)"
    },
    {
      "type": "text",
      "id": "image_caption",
      "label": "Image caption",
      "default": "Sage - with white heart"
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary CTA label",
      "default": "Add to Bag"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary CTA URL"
    }
  ],
  "blocks": [
    {
      "type": "detail_callout",
      "name": "Detail Callout",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading (use / for line break)"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "spec_row",
      "name": "Spec Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Product Hero",
      "blocks": [
        {
          "type": "detail_callout",
          "settings": {
            "eyebrow": "01 - Embroidered heart",
            "heading": "A small mark / near yours.",
            "body": "A small embroidered heart at the left chest. The quiet knowing that you're not the only one holding it all together."
          }
        },
        {
          "type": "detail_callout",
          "settings": {
            "eyebrow": "02 - Sleeve",
            "heading": "Soft strength / on the left sleeve.",
            "body": "'Soft Strength' embroidered in white thread on the left sleeve. Intentional. Not decorative. Something you notice when you need to."
          }
        },
        {
          "type": "detail_callout",
          "settings": {
            "eyebrow": "03 - Fabric",
            "heading": "8.9oz. Heavyweight, / intentionally.",
            "body": "GOTS certified organic cotton fleece. Substantial in your hands. Super soft brushed lining inside. Made to be felt, not just worn."
          }
        },
        {
          "type": "spec_row",
          "settings": {
            "label": "Fabric",
            "value": "8.9 oz organic fleece"
          }
        },
        {
          "type": "spec_row",
          "settings": {
            "label": "Lining",
            "value": "Brushed fleece inside"
          }
        },
        {
          "type": "spec_row",
          "settings": {
            "label": "Certification",
            "value": "GOTS certified organic"
          }
        },
        {
          "type": "spec_row",
          "settings": {
            "label": "Construction",
            "value": "Dropped shoulder, ribbed cuffs"
          }
        }
      ]
    }
  ]
}
{% endschema %}
