<div class="ck-gc-hero">
  <div class="ck-gc-hero__inner">
    {% if section.settings.eyebrow != blank %}
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}
    <h1 class="ck-gc-hero__heading">
      {{ section.settings.heading_plain }}<br>
      <em>{{ section.settings.heading_italic }}</em>
    </h1>
    {% if section.settings.subtitle != blank %}
      <p class="ck-gc-hero__subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}
  </div>
</div>

{% assign step_blocks = section.blocks | where: 'type', 'step' %}
{% if step_blocks.size > 0 %}
  <div class="ck-gc-steps">
    <div class="ck-gc-steps__inner">
      <h2 class="ck-gc-steps__heading">{{ section.settings.steps_title | default: 'How it works' }}</h2>
      <div class="ck-gc-steps__grid">
        {% for block in step_blocks %}
          <div class="ck-gc-step" {{ block.shopify_attributes }}>
            {% if block.settings.number != blank %}
              <div class="ck-gc-step__num">{{ block.settings.number }}</div>
            {% endif %}
            {% if block.settings.title != blank %}
              <h3 class="ck-gc-step__title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.body != blank %}
              <p class="ck-gc-step__body">{{ block.settings.body }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

<div class="ck-gc-products">
  <div class="ck-gc-products__inner">
    <h2 class="ck-gc-products__heading">{{ section.settings.products_title | default: 'Choose your piece' }}</h2>
    <div class="ck-gc-products__grid">
      {% if section.settings.product_1 != blank %}
        {%- assign p1 = all_products[section.settings.product_1] -%}
        {% if p1 != blank %}
          <a href="{{ p1.url }}" class="ck-gc-card">
            <div class="ck-gc-card__image">
              {% if p1.featured_image %}
                {{ p1.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: p1.featured_image.alt }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </div>
            <div class="ck-gc-card__body">
              <h3 class="ck-gc-card__title">{{ p1.title }}</h3>
              <p class="ck-gc-card__price">{{ p1.price | money }}</p>
              <span class="ck-btn ck-btn--secondary" style="font-size:0.75rem;">Send as a Gift</span>
            </div>
          </a>
        {% endif %}
      {% else %}
        <div class="ck-gc-card">
          <div class="ck-gc-card__image">{{ 'product-1' | placeholder_svg_tag }}</div>
          <div class="ck-gc-card__body">
            <h3 class="ck-gc-card__title">The Soft Strength Hoodie</h3>
            <p class="ck-gc-card__price">$72</p>
          </div>
        </div>
      {% endif %}

      {% if section.settings.product_2 != blank %}
        {%- assign p2 = all_products[section.settings.product_2] -%}
        {% if p2 != blank %}
          <a href="{{ p2.url }}" class="ck-gc-card">
            <div class="ck-gc-card__image">
              {% if p2.featured_image %}
                {{ p2.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: p2.featured_image.alt }}
              {% else %}
                {{ 'product-2' | placeholder_svg_tag }}
              {% endif %}
            </div>
            <div class="ck-gc-card__body">
              <h3 class="ck-gc-card__title">{{ p2.title }}</h3>
              <p class="ck-gc-card__price">{{ p2.price | money }}</p>
              <span class="ck-btn ck-btn--secondary" style="font-size:0.75rem;">Send as a Gift</span>
            </div>
          </a>
        {% endif %}
      {% else %}
        <div class="ck-gc-card">
          <div class="ck-gc-card__image">{{ 'product-2' | placeholder_svg_tag }}</div>
          <div class="ck-gc-card__body">
            <h3 class="ck-gc-card__title">The Soft Strength Crewneck</h3>
            <p class="ck-gc-card__price">$68</p>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<div class="ck-gc-details">
  <div class="ck-gc-details__inner">
    <h2 class="ck-gc-details__heading">{{ section.settings.details_title | default: 'What arrives' }}</h2>
    <p class="ck-gc-details__body">
      Your gift arrives in our signature packaging — soft, minimal, considered. Your private note is included. No pricing, no packing slip. Just something soft, showing up when it matters.
    </p>
  </div>
</div>

{% schema %}
{
  "name": "Give Comfort Page",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Give Comfort"
    },
    {
      "type": "text",
      "id": "heading_plain",
      "label": "Heading (plain)",
      "default": "Send softness to someone"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading (italic)",
      "default": "holding a lot."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "The softest thing you can send. Add a private note at checkout — no pricing, no packing slip. Just something soft, on its way."
    },
    {
      "type": "text",
      "id": "steps_title",
      "label": "Steps section title",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "products_title",
      "label": "Products section title",
      "default": "Choose your piece"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "text",
      "id": "details_title",
      "label": "Details section title",
      "default": "What arrives"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "How it Works Step",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Step number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step title"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Step body"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Give Comfort Page",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "number": "01",
            "title": "Choose the piece",
            "body": "The Soft Strength Hoodie or Crewneck. Both made from the same heavyweight organic fleece."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "02",
            "title": "Write your note",
            "body": "Add a private gift message at checkout. It's just between you and them — we don't read it."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "03",
            "title": "We send it",
            "body": "Ships directly to them. No pricing on the packing slip. Just something soft, arriving when the day was hard."
          }
        }
      ]
    }
  ]
}
{% endschema %}
