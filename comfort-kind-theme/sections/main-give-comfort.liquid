{%- assign hoodie = all_products['soft-strength-hoodie'] -%}
{%- assign crewneck = all_products['soft-strength-organic-crew-neck'] -%}

<!-- Breadcrumb -->
<nav class="ck-breadcrumb" aria-label="Breadcrumb">
  <a href="/" style="color:var(--mute);text-decoration:none;">Comfort Kind</a>
  <span style="margin:0 8px;color:var(--mute);">&middot;</span>
  <span>Give Comfort</span>
</nav>

<!-- Hero Split -->
<div class="ck-gc-hero-split">
  <div class="ck-gc-hero-split__copy">
    <div style="display:flex;align-items:center;gap:8px;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:var(--taupe-dark);margin-bottom:24px;">
      <svg width="14" height="12" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11 18.5C2.5 13 1 8 1 5.5 1 3 3 1 5.5 1c2 0 3.6 1 5.5 3 1.9-2 3.5-3 5.5-3C19 1 21 3 21 5.5c0 2.5-1.5 7.5-10 13z" fill="#B08D6E" stroke="#B08D6E" stroke-width="0.5"/></svg>
      Give Comfort
    </div>
    <h1>When you can't be there, <em>send softness.</em></h1>
    <p style="color:var(--ink-2);font-size:17px;line-height:1.75;margin:24px 0 36px;max-width:440px;">A hoodie or crewneck, shipped straight to the person who needs it. No price. No packing slip. Just something soft, arriving when the day was hard.</p>
    <a href="#ck-choose" class="ck-btn ck-btn--primary">Start a Gift</a>
  </div>
  <div class="ck-gc-hero-split__img" style="{% if section.settings.hero_image != blank %}background-image:url('{{ section.settings.hero_image | image_url: width: 1200 }}');{% endif %}"></div>
</div>

<!-- How it works -->
<div class="ck-gc-how-it-works">
  <div class="ck-gc-how-it-works__grid">
    {%- assign step_blocks = section.blocks | where: 'type', 'step' -%}
    {%- if step_blocks.size > 0 -%}
      {%- for block in step_blocks -%}
        <div class="ck-gc-step-card" {{ block.shopify_attributes }}>
          <div class="ck-gc-step-mark"><em>{{ block.settings.num }}</em></div>
          <div class="ck-gc-step-card__title">{{ block.settings.title }}</div>
          <p class="ck-gc-step-card__body">{{ block.settings.body }}</p>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="ck-gc-step-card">
        <div class="ck-gc-step-mark"><em>1</em></div>
        <div class="ck-gc-step-card__title">Choose the piece</div>
        <p class="ck-gc-step-card__body">The hoodie or the crewneck. Same fleece, same heart, same softness - choose whichever feels right for them.</p>
      </div>
      <div class="ck-gc-step-card">
        <div class="ck-gc-step-mark"><em>2</em></div>
        <div class="ck-gc-step-card__title">Write your note</div>
        <p class="ck-gc-step-card__body">A few words - or just a name. We hand-copy it onto a card that goes in the box. You do not need to have the right words.</p>
      </div>
      <div class="ck-gc-step-card">
        <div class="ck-gc-step-mark"><em>3</em></div>
        <div class="ck-gc-step-card__title">We send it</div>
        <p class="ck-gc-step-card__body">Straight to their door. No price, no packing slip. Just something soft, arriving when the day was hard.</p>
      </div>
    {%- endif -%}
  </div>
</div>

<!-- Choose the piece -->
<div class="ck-gc-choose" id="ck-choose">
  <div class="ck-gc-choose__inner">
    <div style="margin-bottom:48px;">
      <div style="font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:var(--taupe-dark);margin-bottom:14px;">The pieces</div>
      <h2 style="font-family:'Cormorant Garamond',serif;font-size:42px;line-height:1.1;font-style:italic;color:var(--ink);margin:0;">Two ways to be held.</h2>
    </div>
    <div class="ck-gc-products-grid">

      <!-- Hoodie Card -->
      <div class="ck-gc-product-card">
        <div class="ck-gc-product-card__img" style="{% if hoodie.featured_image %}background-image:url('{{ hoodie.featured_image | image_url: width: 800 }}');{% endif %}"></div>
        <div class="ck-gc-product-card__body">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;">
            <h3>{{ hoodie.title | default: 'The Soft Strength Hoodie' }}</h3>
            <span class="ck-gc-product-card__price">{{ hoodie.price | default: 7200 | money }}</span>
          </div>
          <p class="ck-gc-product-card__blurb">Heavyweight organic fleece with a brushed interior. The hoodie that started everything - chosen first for how it feels, not how it looks.</p>
          <!-- Color swatches -->
          <div style="display:flex;gap:8px;align-items:center;">
            <span style="font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:var(--mute);margin-right:4px;">Colors</span>
            {%- for variant in hoodie.variants limit: 3 -%}
              {%- if variant.option1 -%}
                <div style="width:22px;height:22px;border-radius:50%;background:var(--cream-3);border:1px solid var(--line);" title="{{ variant.option1 }}"></div>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <!-- Key features -->
          <div>
            <div style="font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:var(--taupe-dark);margin-bottom:12px;">What you're sending</div>
            <ul class="ck-gc-keys">
              <li>
                <svg width="14" height="12" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11 18.5C2.5 13 1 8 1 5.5 1 3 3 1 5.5 1c2 0 3.6 1 5.5 3 1.9-2 3.5-3 5.5-3C19 1 21 3 21 5.5c0 2.5-1.5 7.5-10 13z" fill="#B08D6E" stroke="#B08D6E" stroke-width="0.5"/></svg>
                8.9 oz organic fleece, brushed soft inside
              </li>
              <li>
                <svg width="14" height="12" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11 18.5C2.5 13 1 8 1 5.5 1 3 3 1 5.5 1c2 0 3.6 1 5.5 3 1.9-2 3.5-3 5.5-3C19 1 21 3 21 5.5c0 2.5-1.5 7.5-10 13z" fill="#B08D6E" stroke="#B08D6E" stroke-width="0.5"/></svg>
                GOTS, OCS, GRS certified
              </li>
              <li>
                <svg width="14" height="12" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11 18.5C2.5 13 1 8 1 5.5 1 3 3 1 5.5 1c2 0 3.6 1 5.5 3 1.9-2 3.5-3 5.5-3C19 1 21 3 21 5.5c0 2.5-1.5 7.5-10 13z" fill="#B08D6E" stroke="#B08D6E" stroke-width="0.5"/></svg>
                Dropped shoulders, no drawstring
              </li>
              <li>
                <svg width="14" height="12" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11 18.5C2.5 13 1 8 1 5.5 1 3 3 1 5.5 1c2 0 3.6 1 5.5 3 1.9-2 3.5-3 5.5-3C19 1 21 3 21 5.5c0 2.5-1.5 7.5-10 13z" fill="#B08D6E" stroke="#B08D6E" stroke-width="0.5"/></svg>
                No price, no packing slip in the box
              </li>
            </ul>
          </div>
          <!-- Accordion -->
          <div class="ck-gc-differ">
            <button class="ck-gc-differ__btn" type="button" onclick="ckDifferToggle(this)">
              What makes it different
              <span>+</span>
            </button>
            <div class="ck-gc-differ__body">
              <div class="ck-gc-differ__inner">
                <div class="ck-gc-differ__row">
                  <div class="ck-gc-differ__label">Weight</div>
                  <p class="ck-gc-differ__text">8.9 oz is heavier than most. You feel it before you put it on. That is intentional.</p>
                </div>
                <div class="ck-gc-differ__row">
                  <div class="ck-gc-differ__label">Inside</div>
                  <p class="ck-gc-differ__text">Brushed fleece lining. The softness you feel first. The reason people keep reaching for it.</p>
                </div>
                <div class="ck-gc-differ__row">
                  <div class="ck-gc-differ__label">Details</div>
                  <p class="ck-gc-differ__text">No drawstring. Dropped shoulders. Nothing to fuss with. Everything considered.</p>
                </div>
              </div>
            </div>
          </div>
          <a href="{{ hoodie.url | default: '/products/soft-strength-hoodie' }}" class="ck-btn ck-btn--primary" style="margin-top:8px;">Send the Hoodie</a>
        </div>
      </div>

      <!-- Crewneck Card -->
      <div class="ck-gc-product-card">
        <div class="ck-gc-product-card__img" style="{% if crewneck.featured_image %}background-image:url('{{ crewneck.featured_image | image_url: width: 800 }}');{% endif %}"></div>
        <div class="ck-gc-product-card__body">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;">
            <h3>{{ crewneck.title | default: 'The Soft Strength Crewneck' }}</h3>
            <span class="ck-gc-product-card__price">{{ crewneck.price | default: 6800 | money }}</span>
          </div>
          <p class="ck-gc-product-card__blurb">Same fabric, same weight, same softness - without the hood. For someone who prefers a cleaner look, or just does not love hoods. The comfort is identical.</p>
          <!-- Color swatches -->
          <div style="display:flex;gap:8px;align-items:center;">
            <span style="font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:var(--mute);margin-right:4px;">Colors</span>
            {%- for variant in crewneck.variants limit: 3 -%}
              {%- if variant.option1 -%}
                <div style="width:22px;height:22px;border-radius:50%;background:var(--cream-3);border:1px solid var(--line);" title="{{ variant.option1 }}"></div>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <!-- Key features -->
          <div>
            <div style="font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:var(--taupe-dark);margin-bottom:12px;">What you're sending</div>
            <ul class="ck-gc-keys">
              <li>
                <svg width="14" height="12" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11 18.5C2.5 13 1 8 1 5.5 1 3 3 1 5.5 1c2 0 3.6 1 5.5 3 1.9-2 3.5-3 5.5-3C19 1 21 3 21 5.5c0 2.5-1.5 7.5-10 13z" fill="#B08D6E" stroke="#B08D6E" stroke-width="0.5"/></svg>
                Same 8.9 oz organic fleece as the hoodie
              </li>
              <li>
                <svg width="14" height="12" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11 18.5C2.5 13 1 8 1 5.5 1 3 3 1 5.5 1c2 0 3.6 1 5.5 3 1.9-2 3.5-3 5.5-3C19 1 21 3 21 5.5c0 2.5-1.5 7.5-10 13z" fill="#B08D6E" stroke="#B08D6E" stroke-width="0.5"/></svg>
                Cleaner neckline, no hood
              </li>
              <li>
                <svg width="14" height="12" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11 18.5C2.5 13 1 8 1 5.5 1 3 3 1 5.5 1c2 0 3.6 1 5.5 3 1.9-2 3.5-3 5.5-3C19 1 21 3 21 5.5c0 2.5-1.5 7.5-10 13z" fill="#B08D6E" stroke="#B08D6E" stroke-width="0.5"/></svg>
                GOTS, OCS, GRS certified
              </li>
              <li>
                <svg width="14" height="12" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11 18.5C2.5 13 1 8 1 5.5 1 3 3 1 5.5 1c2 0 3.6 1 5.5 3 1.9-2 3.5-3 5.5-3C19 1 21 3 21 5.5c0 2.5-1.5 7.5-10 13z" fill="#B08D6E" stroke="#B08D6E" stroke-width="0.5"/></svg>
                No price, no packing slip in the box
              </li>
            </ul>
          </div>
          <!-- Accordion -->
          <div class="ck-gc-differ">
            <button class="ck-gc-differ__btn" type="button" onclick="ckDifferToggle(this)">
              What makes it different
              <span>+</span>
            </button>
            <div class="ck-gc-differ__body">
              <div class="ck-gc-differ__inner">
                <div class="ck-gc-differ__row">
                  <div class="ck-gc-differ__label">Neckline</div>
                  <p class="ck-gc-differ__text">A clean ribbed crewneck. No hood to manage. Some people simply prefer it that way.</p>
                </div>
                <div class="ck-gc-differ__row">
                  <div class="ck-gc-differ__label">Fabric</div>
                  <p class="ck-gc-differ__text">Identical to the hoodie. Same weight, same softness, same certifications. The only difference is the neckline.</p>
                </div>
                <div class="ck-gc-differ__row">
                  <div class="ck-gc-differ__label">Versatility</div>
                  <p class="ck-gc-differ__text">Layers under a coat more easily. Works in more settings. Still entirely a comfort piece.</p>
                </div>
              </div>
            </div>
          </div>
          <a href="{{ crewneck.url | default: '/products/crewneck' }}" class="ck-btn ck-btn--primary" style="margin-top:8px;">Send the Crewneck</a>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- How a gift arrives -->
<div class="ck-gc-promises">
  <div class="ck-gc-promises__inner">
    <div style="margin-bottom:56px;">
      <div style="font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:var(--taupe-dark);margin-bottom:14px;">The experience</div>
      <h2 style="font-family:'Cormorant Garamond',serif;font-size:42px;line-height:1.1;font-style:italic;color:var(--ink);margin:0;">How a gift arrives.</h2>
    </div>
    <div class="ck-gc-promises__grid">
      {%- assign promise_blocks = section.blocks | where: 'type', 'promise' -%}
      {%- if promise_blocks.size > 0 -%}
        {%- for block in promise_blocks -%}
          <div class="ck-gc-promise" {{ block.shopify_attributes }}>
            <svg width="18" height="16" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11 18.5C2.5 13 1 8 1 5.5 1 3 3 1 5.5 1c2 0 3.6 1 5.5 3 1.9-2 3.5-3 5.5-3C19 1 21 3 21 5.5c0 2.5-1.5 7.5-10 13z" fill="#B08D6E" stroke="#B08D6E" stroke-width="0.5"/></svg>
            <div>
              <h3>{{ block.settings.label }}</h3>
              <p>{{ block.settings.body }}</p>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="ck-gc-promise">
          <svg width="18" height="16" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11 18.5C2.5 13 1 8 1 5.5 1 3 3 1 5.5 1c2 0 3.6 1 5.5 3 1.9-2 3.5-3 5.5-3C19 1 21 3 21 5.5c0 2.5-1.5 7.5-10 13z" fill="#B08D6E" stroke="#B08D6E" stroke-width="0.5"/></svg>
          <div>
            <h3>No price, ever</h3>
            <p>No invoice, no packing slip, no price on the label. The recipient will never know what you paid. They will only know you thought of them.</p>
          </div>
        </div>
        <div class="ck-gc-promise">
          <svg width="18" height="16" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11 18.5C2.5 13 1 8 1 5.5 1 3 3 1 5.5 1c2 0 3.6 1 5.5 3 1.9-2 3.5-3 5.5-3C19 1 21 3 21 5.5c0 2.5-1.5 7.5-10 13z" fill="#B08D6E" stroke="#B08D6E" stroke-width="0.5"/></svg>
          <div>
            <h3>A handwritten card</h3>
            <p>Your note, hand-copied onto a card. Even if it is just a name. Even if it is two words. It is the thing that makes a package feel like a person showed up.</p>
          </div>
        </div>
        <div class="ck-gc-promise">
          <svg width="18" height="16" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11 18.5C2.5 13 1 8 1 5.5 1 3 3 1 5.5 1c2 0 3.6 1 5.5 3 1.9-2 3.5-3 5.5-3C19 1 21 3 21 5.5c0 2.5-1.5 7.5-10 13z" fill="#B08D6E" stroke="#B08D6E" stroke-width="0.5"/></svg>
          <div>
            <h3>Ships to them, not you</h3>
            <p>Give their address at checkout. We ship it straight there. You do not need to be an intermediary. You just need to care.</p>
          </div>
        </div>
        <div class="ck-gc-promise">
          <svg width="18" height="16" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11 18.5C2.5 13 1 8 1 5.5 1 3 3 1 5.5 1c2 0 3.6 1 5.5 3 1.9-2 3.5-3 5.5-3C19 1 21 3 21 5.5c0 2.5-1.5 7.5-10 13z" fill="#B08D6E" stroke="#B08D6E" stroke-width="0.5"/></svg>
          <div>
            <h3>You can stay anonymous</h3>
            <p>Sign it with a name, a nickname, or nothing at all. We will copy exactly what you write. The gift will still mean something, whoever it is from.</p>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<!-- Closing CTA -->
{% render 'give-comfort-strip' %}

<script>
  function ckDifferToggle(btn) {
    var body = btn.nextElementSibling;
    var isOpen = body.classList.contains('open');
    body.classList.toggle('open', !isOpen);
  }
</script>

{% schema %}
{
  "name": "Give Comfort Page",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "How it works step",
      "settings": [
        {
          "type": "text",
          "id": "num",
          "label": "Step number",
          "default": "1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step title",
          "default": "Choose the piece"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Step description",
          "default": "The hoodie or the crewneck. Same fleece, same heart."
        }
      ]
    },
    {
      "type": "promise",
      "name": "Gift promise",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Promise title",
          "default": "No price, ever"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Promise body",
          "default": "No invoice, no packing slip. The recipient will only know you thought of them."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Give Comfort Page"
    }
  ]
}
{% endschema %}
