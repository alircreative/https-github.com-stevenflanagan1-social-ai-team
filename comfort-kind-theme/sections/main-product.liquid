{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'product-form-' | append: section.id
-%}

<div class="ck-pdp">
  <div class="ck-pdp__inner">

    <!-- Gallery -->
    <div class="ck-pdp__gallery" id="ck-gallery">
      <div class="ck-pdp__main-image" id="ck-main-image">
        {% if product.featured_image %}
          <img
            src="{{ product.featured_image | image_url: width: 900 }}"
            alt="{{ product.featured_image.alt | escape }}"
            id="ck-main-img"
            width="900"
            loading="eager"
          >
        {% else %}
          {{ 'product-1' | placeholder_svg_tag }}
        {% endif %}
      </div>

      {% if product.images.size > 1 %}
        <div class="ck-pdp__thumbnails" id="ck-thumbs">
          {% for image in product.images %}
            <button
              class="ck-pdp__thumb{% if forloop.first %} is-active{% endif %}"
              data-image-src="{{ image | image_url: width: 900 }}"
              data-image-alt="{{ image.alt | escape }}"
              aria-label="View image {{ forloop.index }}"
              type="button"
            >
              <img
                src="{{ image | image_url: width: 200 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="200"
              >
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Product Info -->
    <div class="ck-pdp__info">
      <span class="ck-pdp__eyebrow">{{ product.type | default: 'The Soft Strength Collection' }}</span>

      <h1 class="ck-pdp__title">{{ product.title }}</h1>

      <p class="ck-pdp__price" id="ck-price">
        {{ current_variant.price | money }}
      </p>

      {% if product.description != blank %}
        <div class="ck-pdp__short-desc">{{ product.description }}</div>
      {% endif %}

      {%- form 'product', product, id: product_form_id, novalidate: 'novalidate' -%}
        <input type="hidden" name="id" id="ck-variant-id" value="{{ current_variant.id }}">

        {% for option in product.options_with_values %}
          <div class="ck-pdp__options">
            {% if option.name == 'Color' or option.name == 'Colour' %}
              <p class="ck-pdp__option-label">
                {{ option.name }}: <span id="ck-color-label">{{ option.selected_value }}</span>
              </p>
              <div class="ck-pdp__swatches" data-option-index="{{ forloop.index0 }}">
                {% for value in option.values %}
                  {%- assign swatch_color = value | downcase | replace: ' ', '' -%}
                  <button
                    type="button"
                    class="ck-pdp__swatch{% if option.selected_value == value %} is-active{% endif %}"
                    data-value="{{ value }}"
                    data-option-index="{{ forloop.index0 }}"
                    style="background-color: {{ swatch_color }};"
                    title="{{ value }}"
                    aria-label="Select color {{ value }}"
                  ></button>
                {% endfor %}
              </div>
            {% elsif option.name == 'Size' %}
              <p class="ck-pdp__option-label">
                {{ option.name }}: <span id="ck-size-label">{{ option.selected_value }}</span>
              </p>
              <div class="ck-pdp__sizes" data-option-index="{{ forloop.index0 }}">
                {% for value in option.values %}
                  <button
                    type="button"
                    class="ck-pdp__size-pill{% if option.selected_value == value %} is-active{% endif %}"
                    data-value="{{ value }}"
                    data-option-index="{{ forloop.index0 }}"
                  >{{ value }}</button>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endfor %}

        <div class="ck-pdp__qty">
          <button type="button" class="ck-pdp__qty-btn" id="ck-qty-minus" aria-label="Decrease quantity">-</button>
          <input
            type="number"
            class="ck-pdp__qty-input"
            id="ck-qty"
            name="quantity"
            value="1"
            min="1"
            aria-label="Quantity"
          >
          <button type="button" class="ck-pdp__qty-btn" id="ck-qty-plus" aria-label="Increase quantity">+</button>
        </div>

        <div class="ck-pdp__add">
          <button
            type="submit"
            name="add"
            class="ck-btn ck-btn--primary ck-btn--full"
            id="ck-add-to-cart"
            {% unless current_variant.available %}disabled{% endunless %}
          >
            {% if current_variant.available %}
              Add to Bag
            {% else %}
              Sold Out
            {% endif %}
          </button>
          <a href="/pages/give-comfort" class="ck-pdp__gift-link">Send as a Gift &rarr;</a>
        </div>

      {%- endform -%}

      <div class="ck-pdp__trust">
        <span class="ck-pdp__trust-item">30-Day Guarantee</span>
        <span class="ck-pdp__trust-item">Free Shipping over $75</span>
        <span class="ck-pdp__trust-item">GOTS Certified</span>
      </div>

      <div class="ck-pdp__accordion">
        <div class="ck-accordion__item">
          <button class="ck-accordion__trigger" type="button" aria-expanded="false">
            Fabric &amp; Care
            <svg class="ck-accordion__icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
              <line x1="10" y1="4" x2="10" y2="16"/>
              <line x1="4" y1="10" x2="16" y2="10"/>
            </svg>
          </button>
          <div class="ck-accordion__body">
            <div class="ck-accordion__content">
              {% if section.settings.fabric_care != blank %}
                {{ section.settings.fabric_care }}
              {% else %}
                <p>8.9 oz GOTS certified organic cotton fleece. Brushed super soft lining inside. Machine wash cold, tumble dry low. Do not bleach. Do not iron embroidery.</p>
              {% endif %}
            </div>
          </div>
        </div>

        <div class="ck-accordion__item">
          <button class="ck-accordion__trigger" type="button" aria-expanded="false">
            Give Comfort
            <svg class="ck-accordion__icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
              <line x1="10" y1="4" x2="10" y2="16"/>
              <line x1="4" y1="10" x2="16" y2="10"/>
            </svg>
          </button>
          <div class="ck-accordion__body">
            <div class="ck-accordion__content">
              <p>Want to send this as a gift? Add a private note at checkout and we'll ship it directly to them — no pricing, no packing slip. Just something soft, on its way.</p>
            </div>
          </div>
        </div>

        <div class="ck-accordion__item">
          <button class="ck-accordion__trigger" type="button" aria-expanded="false">
            Shipping &amp; Returns
            <svg class="ck-accordion__icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
              <line x1="10" y1="4" x2="10" y2="16"/>
              <line x1="4" y1="10" x2="16" y2="10"/>
            </svg>
          </button>
          <div class="ck-accordion__body">
            <div class="ck-accordion__content">
              <p>Ships in 3-5 business days. Free shipping on orders over $75. 30-day comfort guarantee — if it doesn't feel right, we'll make it right.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Detail Callouts below fold -->
<div class="ck-material">
  {% for block in section.blocks %}
    {% if block.type == 'detail_callout' %}
      {%- assign is_reversed = forloop.index0 | modulo: 2 -%}
      <div class="ck-mat-cell{% if is_reversed == 1 %} ck-mat-cell--reversed{% endif %}" {{ block.shopify_attributes }}>
        <div class="ck-mat-cell__image">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.image.alt }}
          {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag }}
          {% endif %}
        </div>
        <div class="ck-mat-cell__text">
          {% if block.settings.eyebrow != blank %}
            <span class="ck-mat-cell__eyebrow">{{ block.settings.eyebrow }}</span>
          {% endif %}
          {% if block.settings.heading != blank %}
            <h3 class="ck-mat-cell__heading">{{ block.settings.heading | replace: ' / ', '<br>' }}</h3>
          {% endif %}
          {% if block.settings.body != blank %}
            <p class="ck-mat-cell__body">{{ block.settings.body }}</p>
          {% endif %}
        </div>
      </div>
    {% endif %}
  {% endfor %}
</div>

{% if section.blocks.size > 0 %}
  <div class="ck-mat-specs">
    {% for block in section.blocks %}
      {% if block.type == 'spec_row' %}
        <div class="ck-mat-specs__row" {{ block.shopify_attributes }}>
          <span class="ck-mat-spec-label">{{ block.settings.label }}</span>
          <span class="ck-mat-spec-val">{{ block.settings.value }}</span>
        </div>
      {% endif %}
    {% endfor %}
  </div>
{% endif %}

{% if section.settings.companion_product != blank %}
  {%- assign companion = all_products[section.settings.companion_product] -%}
  {% if companion != blank %}
    <div class="ck-also-like">
      <div class="ck-also-like__inner">
        <h2 class="ck-also-like__heading">You may also like</h2>
        <a href="{{ companion.url }}" class="ck-gc-card" style="max-width:380px; display:block;">
          <div class="ck-gc-card__image">
            {% if companion.featured_image %}
              {{ companion.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: companion.featured_image.alt }}
            {% else %}
              {{ 'product-2' | placeholder_svg_tag }}
            {% endif %}
          </div>
          <div class="ck-gc-card__body">
            <h3 class="ck-gc-card__title">{{ companion.title }}</h3>
            <p class="ck-gc-card__price">{{ companion.price | money }}</p>
            <span class="ck-btn ck-btn--secondary" style="font-size:0.75rem;">Shop Now</span>
          </div>
        </a>
      </div>
    </div>
  {% endif %}
{% endif %}

<script>
(function() {
  var productData = {{ product.variants | json }};
  var selectedOptions = [];

  // Init selected options from current variant
  var currentVariant = {{ current_variant | json }};
  if (currentVariant && currentVariant.options) {
    selectedOptions = currentVariant.options.slice();
  }

  function findVariant(options) {
    return productData.find(function(v) {
      return v.options.every(function(opt, i) {
        return opt === options[i];
      });
    });
  }

  function updateVariant() {
    var variant = findVariant(selectedOptions);
    if (!variant) return;

    // Update hidden id
    var idInput = document.getElementById('ck-variant-id');
    if (idInput) idInput.value = variant.id;

    // Update price
    var priceEl = document.getElementById('ck-price');
    if (priceEl) {
      var cents = variant.price;
      var dollars = (cents / 100).toFixed(2);
      priceEl.textContent = '$' + dollars;
    }

    // Update add to cart button
    var btn = document.getElementById('ck-add-to-cart');
    if (btn) {
      btn.disabled = !variant.available;
      btn.textContent = variant.available ? 'Add to Bag' : 'Sold Out';
    }

    // Swap image if variant has one
    if (variant.featured_image) {
      swapMainImage(variant.featured_image.src, variant.featured_image.alt || '');
    }
  }

  function swapMainImage(src, alt) {
    var mainImg = document.getElementById('ck-main-img');
    if (!mainImg) return;
    mainImg.style.opacity = '0';
    setTimeout(function() {
      mainImg.src = src;
      mainImg.alt = alt;
      mainImg.style.opacity = '1';
    }, 150);
  }

  // Swatch clicks
  document.querySelectorAll('.ck-pdp__swatch').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var optIdx = parseInt(this.dataset.optionIndex);
      var val = this.dataset.value;
      selectedOptions[optIdx] = val;

      // Update active state
      var container = this.closest('[data-option-index]');
      container.querySelectorAll('.ck-pdp__swatch').forEach(function(s) {
        s.classList.toggle('is-active', s.dataset.value === val);
      });

      // Update label
      var lbl = document.getElementById('ck-color-label');
      if (lbl) lbl.textContent = val;

      updateVariant();
    });
  });

  // Size pill clicks
  document.querySelectorAll('.ck-pdp__size-pill').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var optIdx = parseInt(this.dataset.optionIndex);
      var val = this.dataset.value;
      selectedOptions[optIdx] = val;

      var container = this.closest('[data-option-index]');
      container.querySelectorAll('.ck-pdp__size-pill').forEach(function(p) {
        p.classList.toggle('is-active', p.dataset.value === val);
      });

      var lbl = document.getElementById('ck-size-label');
      if (lbl) lbl.textContent = val;

      updateVariant();
    });
  });

  // Quantity stepper
  var qtyInput = document.getElementById('ck-qty');
  document.getElementById('ck-qty-minus') && document.getElementById('ck-qty-minus').addEventListener('click', function() {
    var val = parseInt(qtyInput.value) || 1;
    if (val > 1) qtyInput.value = val - 1;
  });
  document.getElementById('ck-qty-plus') && document.getElementById('ck-qty-plus').addEventListener('click', function() {
    var val = parseInt(qtyInput.value) || 1;
    qtyInput.value = val + 1;
  });

  // Thumbnail gallery
  document.querySelectorAll('.ck-pdp__thumb').forEach(function(thumb) {
    thumb.addEventListener('click', function() {
      document.querySelectorAll('.ck-pdp__thumb').forEach(function(t) {
        t.classList.remove('is-active');
      });
      this.classList.add('is-active');
      swapMainImage(this.dataset.imageSrc, this.dataset.imageAlt);
    });
  });

  // Add to cart with fetch
  var form = document.getElementById('{{ product_form_id }}');
  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var btn = document.getElementById('ck-add-to-cart');
      if (!btn || btn.disabled) return;

      var formData = new FormData(form);
      btn.textContent = 'Adding...';
      btn.disabled = true;
      btn.classList.add('is-loading');

      fetch('/cart/add.js', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        body: formData
      })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        btn.textContent = 'Added!';
        btn.classList.remove('is-loading');
        // Update cart count
        fetch('/cart.js')
          .then(function(r) { return r.json(); })
          .then(function(cart) {
            var count = document.querySelector('[data-cart-count]');
            if (count) {
              count.textContent = cart.item_count;
              count.setAttribute('data-count', cart.item_count);
            }
          });
        setTimeout(function() {
          btn.textContent = 'Add to Bag';
          btn.disabled = false;
        }, 2000);
      })
      .catch(function(err) {
        console.error('Add to cart error', err);
        btn.textContent = 'Add to Bag';
        btn.disabled = false;
        btn.classList.remove('is-loading');
      });
    });
  }

  // Accordion
  document.querySelectorAll('.ck-accordion__trigger').forEach(function(trigger) {
    trigger.addEventListener('click', function() {
      var item = this.closest('.ck-accordion__item');
      var isOpen = item.classList.contains('is-open');
      item.classList.toggle('is-open', !isOpen);
      this.setAttribute('aria-expanded', !isOpen);
    });
  });
})();
</script>

{% schema %}
{
  "name": "Product Page",
  "settings": [
    {
      "type": "richtext",
      "id": "fabric_care",
      "label": "Fabric & Care content"
    },
    {
      "type": "product",
      "id": "companion_product",
      "label": "You may also like - product"
    }
  ],
  "blocks": [
    {
      "type": "detail_callout",
      "name": "Detail Callout",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading (use / for line break)"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "spec_row",
      "name": "Spec Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Page",
      "blocks": [
        {
          "type": "detail_callout",
          "settings": {
            "eyebrow": "01 · Embroidered heart",
            "heading": "A small mark / near yours.",
            "body": "A small embroidered heart at the left chest. The quiet knowing that you're not the only one holding it all together."
          }
        },
        {
          "type": "detail_callout",
          "settings": {
            "eyebrow": "02 · Sleeve",
            "heading": "Soft strength / on the left sleeve.",
            "body": "'Soft Strength' embroidered in white thread on the left sleeve. Intentional. Not decorative. Something you notice when you need to."
          }
        },
        {
          "type": "detail_callout",
          "settings": {
            "eyebrow": "03 · Fabric",
            "heading": "8.9oz. Heavyweight, / intentionally.",
            "body": "GOTS certified organic cotton fleece. Substantial in your hands. Super soft brushed lining inside. Made to be felt, not just worn."
          }
        },
        {
          "type": "spec_row",
          "settings": {
            "label": "Fabric",
            "value": "8.9 oz organic fleece"
          }
        },
        {
          "type": "spec_row",
          "settings": {
            "label": "Lining",
            "value": "Brushed fleece inside"
          }
        },
        {
          "type": "spec_row",
          "settings": {
            "label": "Certification",
            "value": "GOTS certified organic"
          }
        },
        {
          "type": "spec_row",
          "settings": {
            "label": "Construction",
            "value": "Dropped shoulder, ribbed cuffs"
          }
        }
      ]
    }
  ]
}
{% endschema %}
