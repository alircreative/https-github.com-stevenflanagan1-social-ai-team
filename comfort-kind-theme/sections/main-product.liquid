{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'product-form-' | append: section.id
-%}

<!-- Breadcrumb -->
<nav class="ck-breadcrumb" aria-label="Breadcrumb">
  <a href="/collections/all" style="color:var(--mute);text-decoration:none;">Shop</a>
  <span style="margin:0 8px;color:var(--mute);">&middot;</span>
  <a href="/collections/hoodies" style="color:var(--mute);text-decoration:none;">Hoodies</a>
  <span style="margin:0 8px;color:var(--mute);">&middot;</span>
  <span>{{ product.title }}</span>
</nav>

<!-- Product Hero -->
<div style="display:grid;grid-template-columns:1.15fr 1fr;background:var(--cream);align-items:stretch;">

  <!-- Gallery -->
  <div style="display:grid;grid-template-columns:88px 1fr;gap:20px;padding:32px 32px 32px 48px;" id="ck-gallery-{{ section.id }}">
    <div style="display:flex;flex-direction:column;gap:12px;">
      {%- for image in product.images limit: 6 -%}
        <button type="button" onclick="ckSetMainImage('{{ section.id }}','{{ image | image_url: width: 900 }}')" style="border:1px solid var(--line);background:none;padding:0;cursor:pointer;aspect-ratio:1;overflow:hidden;">
          {{ image | image_url: width: 120 | image_tag: loading: 'lazy', alt: image.alt }}
        </button>
      {%- endfor -%}
    </div>
    <div style="overflow:hidden;display:flex;align-items:flex-start;">
      {%- if product.featured_image -%}
        <img id="ck-main-img-{{ section.id }}" src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.featured_image.alt | escape }}" loading="eager" style="width:100%;height:auto;object-fit:contain;display:block;">
      {%- else -%}
        <div style="width:100%;aspect-ratio:4/5;background:var(--cream-3);"></div>
      {%- endif -%}
    </div>
  </div>

  <!-- Product Info -->
  <div style="padding:48px 64px 48px 40px;display:flex;flex-direction:column;justify-content:center;background:var(--cream);">

    <div style="display:flex;align-items:center;gap:8px;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:var(--taupe-dark);margin-bottom:18px;">
      <svg width="18" height="16" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11 18.5C2.5 13 1 8 1 5.5 1 3 3 1 5.5 1c2 0 3.6 1 5.5 3 1.9-2 3.5-3 5.5-3C19 1 21 3 21 5.5c0 2.5-1.5 7.5-10 13z" fill="#B08D6E" stroke="#B08D6E" stroke-width="0.5"/></svg>
      The Hero Piece
    </div>

    <h1 style="font-family:'Cormorant Garamond',serif;font-size:52px;line-height:1.04;font-weight:400;margin:0 0 28px;letter-spacing:-0.01em;color:var(--ink);">{{ product.title }}</h1>

    <div style="display:flex;align-items:center;gap:24px;margin-bottom:24px;">
      <span style="font-family:'Cormorant Garamond',serif;font-size:28px;color:var(--ink);">{{ current_variant.price | money }}</span>
      <span style="width:1px;height:24px;background:var(--line);display:inline-block;"></span>
      <span style="font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:var(--mute);">30-Day Comfort Guarantee</span>
    </div>

    <div style="color:var(--ink-2);font-size:16px;line-height:1.75;margin:0 0 32px;max-width:460px;">{{ product.description }}</div>

    {%- form 'product', product, id: product_form_id, novalidate: 'novalidate' -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}">

      {%- for option in product.options_with_values -%}
        {%- if option.name == 'Color' -%}
          <div style="margin-bottom:24px;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
              <span style="font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:var(--ink);">Color</span>
              <span style="font-size:12px;color:var(--mute);" id="ck-color-label-{{ section.id }}">{{ option.selected_value }}</span>
            </div>
            <div style="display:flex;gap:10px;">
              {%- for value in option.values -%}
                {%- assign swatch_bg = '#D4C4B0' -%}
                {%- assign vlow = value | downcase -%}
                {%- if vlow == 'sage' -%}{%- assign swatch_bg = '#7E8F6B' -%}{%- endif -%}
                {%- if vlow == 'slate' -%}{%- assign swatch_bg = '#8A9BA8' -%}{%- endif -%}
                {%- if vlow == 'soft gray' or vlow == 'soft grey' -%}{%- assign swatch_bg = '#D8D5D0' -%}{%- assign swatch_border = 'rgba(58,45,36,0.4)' -%}{%- endif -%}
                {%- if vlow == 'cloud' -%}{%- assign swatch_bg = '#ffffff' -%}{%- assign swatch_border = 'rgba(58,45,36,0.4)' -%}{%- endif -%}
                {%- if vlow == 'cream' -%}{%- assign swatch_bg = '#EFE7D8' -%}{%- endif -%}
                {%- if vlow == 'oat' or vlow == 'oatmeal' -%}{%- assign swatch_bg = '#D9CFBC' -%}{%- endif -%}
                {%- if vlow == 'bone' -%}{%- assign swatch_bg = '#E5DDCE' -%}{%- endif -%}
                {%- if vlow == 'sand' -%}{%- assign swatch_bg = '#CFBE9F' -%}{%- endif -%}
                {%- if vlow == 'rose' or vlow == 'dusty rose' -%}{%- assign swatch_bg = '#C9A8A0' -%}{%- endif -%}
                {%- if vlow == 'clay' or vlow == 'terracotta' -%}{%- assign swatch_bg = '#B98F76' -%}{%- endif -%}
                {%- if vlow == 'rust' -%}{%- assign swatch_bg = '#A86B4E' -%}{%- endif -%}
                {%- if vlow == 'ink' or vlow == 'charcoal' -%}{%- assign swatch_bg = '#3A2D24' -%}{%- endif -%}
                {%- if vlow == 'black' -%}{%- assign swatch_bg = '#1A1A1A' -%}{%- endif -%}
                {%- if vlow == 'green bay' -%}{%- assign swatch_bg = '#5A6B4A' -%}{%- endif -%}
                {%- if vlow == 'forest' -%}{%- assign swatch_bg = '#3D4E36' -%}{%- endif -%}
                {%- if vlow == 'navy' -%}{%- assign swatch_bg = '#2A3A4E' -%}{%- endif -%}
                <button type="button" class="ck-swatch" onclick="ckSelectColor('{{ section.id }}','{{ value }}')" style="width:36px;height:36px;border-radius:50%;background:{{ swatch_bg }};border:1px solid rgba(58,45,36,0.25);box-shadow:0 0 0 2px transparent;cursor:pointer;display:flex;align-items:center;justify-content:center;" title="{{ value }}" data-value="{{ value }}">
                  <svg width="10" height="9" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11 18.5C2.5 13 1 8 1 5.5 1 3 3 1 5.5 1c2 0 3.6 1 5.5 3 1.9-2 3.5-3 5.5-3C19 1 21 3 21 5.5c0 2.5-1.5 7.5-10 13z" fill="rgba(255,255,255,0.7)" stroke="rgba(255,255,255,0.5)" stroke-width="0.5"/></svg>
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- for option in product.options_with_values -%}
        {%- if option.name == 'Size' -%}
          <div style="margin-bottom:28px;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
              <span style="font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:var(--ink);">Size</span>
              <a href="#size-guide" style="font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--mute);text-decoration:none;">Size Guide</a>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
              {%- for value in option.values -%}
                <button type="button" class="ck-size-pill" onclick="ckSelectSize('{{ section.id }}','{{ value }}')" data-value="{{ value }}" style="padding:10px 18px;border:1px solid var(--line-2);background:transparent;font-family:'Jost',sans-serif;font-size:13px;letter-spacing:0.1em;color:var(--ink);cursor:pointer;transition:all .2s;">{{ value }}</button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <div style="margin-bottom:24px;padding:20px;border:1px solid var(--line);background:var(--cream-2);">
        <label style="display:flex;align-items:flex-start;gap:12px;cursor:pointer;">
          <input type="checkbox" id="ck-gift-toggle-{{ section.id }}" onchange="ckToggleGift('{{ section.id }}')" style="margin-top:3px;accent-color:var(--ink);">
          <div>
            <div style="display:flex;align-items:center;gap:8px;font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:var(--ink);font-weight:600;margin-bottom:4px;">
              <svg width="14" height="12" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11 18.5C2.5 13 1 8 1 5.5 1 3 3 1 5.5 1c2 0 3.6 1 5.5 3 1.9-2 3.5-3 5.5-3C19 1 21 3 21 5.5c0 2.5-1.5 7.5-10 13z" fill="#B08D6E" stroke="#B08D6E" stroke-width="0.5"/></svg>
              Send as a Give Comfort gift
            </div>
            <p style="color:var(--mute);font-size:13px;line-height:1.55;margin:0;">Add a handwritten note. We ship directly to them. No price, no packing slip.</p>
          </div>
        </label>
        <div id="ck-gift-note-{{ section.id }}" style="display:none;margin-top:16px;">
          <textarea name="note" placeholder="Your gift note..." rows="3" style="width:100%;padding:12px;border:1px solid var(--line-2);background:var(--cream);font-family:'Jost',sans-serif;font-size:14px;color:var(--ink);resize:vertical;box-sizing:border-box;"></textarea>
        </div>
      </div>

      <button type="submit" name="add" style="width:100%;padding:20px;background:var(--ink);color:var(--cream);border:none;font-family:'Jost',sans-serif;font-size:13px;letter-spacing:0.18em;text-transform:uppercase;cursor:pointer;">
        Add to Bag &middot; {{ current_variant.price | money }}
      </button>
    {%- endform -%}

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px 24px;margin-top:28px;">
      <div style="font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:var(--mute);">
        <span style="color:var(--taupe);">-</span> Free returns, 30 days
      </div>
      <div style="font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:var(--mute);">
        <span style="color:var(--taupe);">-</span> Organic certified
      </div>
      <div style="font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:var(--mute);">
        <span style="color:var(--taupe);">-</span> Ships in 2 days
      </div>
      <div style="font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:var(--mute);">
        <span style="color:var(--taupe);">-</span> Gift-ready packaging
      </div>
    </div>
  </div>
</div>

<!-- Trust Strip -->
<div class="ck-trust">
  <div class="cell">
    <span class="label">Fabric</span>
    <span class="text">8.9 oz organic fleece. Brushed soft on the inside.</span>
  </div>
  <div class="cell">
    <span class="label">Certification</span>
    <span class="text">GOTS, OCS and GRS certified. Every claim verified.</span>
  </div>
  <div class="cell">
    <span class="label">Guarantee</span>
    <span class="text">30-day comfort guarantee. No questions, no fees.</span>
  </div>
  <div class="cell">
    <span class="label">Gift-ready</span>
    <span class="text">Ship directly to someone. No price, no packing slip.</span>
  </div>
</div>

<!-- Details Section -->
<div class="ck-details-section">
  <div class="ck-details-section__inner">
    <div class="ck-details-section__sticky">
      <div class="ck-details-section__label">The Details</div>
      <h2 class="ck-details-section__heading">Considered,<br>slowly.</h2>
      <p class="ck-details-section__sub">Every choice in this hoodie was made on purpose. Here is what that looks like, written plainly.</p>
    </div>
    <div>
      <div class="ck-detail-row-grid">
        <div class="ck-detail-row-grid__key">Fabric weight</div>
        <div class="ck-detail-row-grid__val">8.9 oz heavyweight fleece - substantial in your hands before it is even on your body. Heavy enough to feel like protection.</div>
      </div>
      <div class="ck-detail-row-grid">
        <div class="ck-detail-row-grid__key">Composition</div>
        <div class="ck-detail-row-grid__val">80% organic combed ring-spun cotton, 20% recycled polyester. Soft against skin. Holds its shape over time.</div>
      </div>
      <div class="ck-detail-row-grid">
        <div class="ck-detail-row-grid__key">Certifications</div>
        <div class="ck-detail-row-grid__val">GOTS (Global Organic Textile Standard), OCS (Organic Content Standard), GRS (Global Recycled Standard). All third-party verified.</div>
      </div>
      <div class="ck-detail-row-grid">
        <div class="ck-detail-row-grid__key">Construction</div>
        <div class="ck-detail-row-grid__val">Dropped shoulders, waist-length, no drawstring. Easy to layer. Easy to live in.</div>
      </div>
      <div class="ck-detail-row-grid">
        <div class="ck-detail-row-grid__key">Inside finish</div>
        <div class="ck-detail-row-grid__val">Brushed fleece lining. The softness you feel first when you pull it on. That feeling is the whole point.</div>
      </div>
      <div class="ck-detail-row-grid">
        <div class="ck-detail-row-grid__key">Care</div>
        <div class="ck-detail-row-grid__val">Cold wash, inside-out. Tumble dry low or lay flat. It will keep being soft if you let it.</div>
      </div>
    </div>
  </div>
</div>

<!-- Split: The Heart -->
<div class="ck-split{% if section.settings.callout_1_image == blank %} ck-split--no-img{% endif %}">
  {%- if section.settings.callout_1_image != blank -%}
    <div class="ck-split__img" style="background-image:url('{{ section.settings.callout_1_image | image_url: width: 1000 }}');"></div>
  {%- endif -%}
  <div class="ck-split__text">
    <span class="ck-split__label">{{ section.settings.callout_1_label | default: 'The Heart' }}</span>
    <h2 class="ck-split__heading">{{ section.settings.callout_1_heading | default: 'Made for the hard days.' }}</h2>
    <p class="ck-split__body">{{ section.settings.callout_1_body | default: 'This hoodie started as a grief project. A thing to make when I did not know what else to do. The fabric was chosen because it felt like the closest thing to being held. Everything else followed from that.' }}</p>
    <p class="ck-split__body ck-split__body--mute">8.9 oz organic combed ring-spun cotton fleece - brushed soft inside - GOTS certified</p>
  </div>
</div>

<!-- Split: The Sleeve (text left, image right) -->
<div class="ck-split{% if section.settings.callout_2_image == blank %} ck-split--no-img{% endif %}">
  <div class="ck-split__text ck-split__text--light">
    <span class="ck-split__label">{{ section.settings.callout_2_label | default: 'The Sleeve' }}</span>
    <h2 class="ck-split__heading">{{ section.settings.callout_2_heading | default: 'No drawstring. On purpose.' }}</h2>
    <p class="ck-split__body">{{ section.settings.callout_2_body | default: 'A drawstring is one more thing to fuss with on a day when you have no energy for fussing. We left it out intentionally. The hood works fine. Your hands stay free.' }}</p>
  </div>
  {%- if section.settings.callout_2_image != blank -%}
    <div class="ck-split__img" style="background-image:url('{{ section.settings.callout_2_image | image_url: width: 1000 }}');"></div>
  {%- endif -%}
</div>

<!-- Founder Note Band -->
<div class="ck-founder-note">
  <div class="ck-founder-note__inner">
    <div style="display:flex;justify-content:center;margin-bottom:8px;">
      <svg width="18" height="16" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11 18.5C2.5 13 1 8 1 5.5 1 3 3 1 5.5 1c2 0 3.6 1 5.5 3 1.9-2 3.5-3 5.5-3C19 1 21 3 21 5.5c0 2.5-1.5 7.5-10 13z" fill="#B08D6E" stroke="#B08D6E" stroke-width="0.5"/></svg>
    </div>
    <p class="ck-founder-note__quote">"{{ section.settings.founder_quote | default: 'I made the thing I wished someone had sent me. I hope it finds the right person, in the right moment.' }}"</p>
    <p class="ck-founder-note__by">Ali - Founder, ComfortKind</p>
  </div>
</div>

<!-- Review Invite -->
<div class="ck-review-invite">
  <div class="ck-review-invite__inner">
    <div class="ck-review-invite__card">
      <div style="display:flex;justify-content:center;">
        <svg width="22" height="19" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11 18.5C2.5 13 1 8 1 5.5 1 3 3 1 5.5 1c2 0 3.6 1 5.5 3 1.9-2 3.5-3 5.5-3C19 1 21 3 21 5.5c0 2.5-1.5 7.5-10 13z" fill="#B08D6E" stroke="#B08D6E" stroke-width="0.5"/></svg>
      </div>
      <h2 class="ck-review-invite__heading">No notes yet.</h2>
      <p class="ck-review-invite__body">Be the first to share how it felt when it arrived. A few honest words help the next person decide.</p>
      <div class="ck-review-invite__meta">
        <span>Verified purchases only</span>
        <span>Plain words, real experiences</span>
        <span>No minimum length</span>
      </div>
    </div>
  </div>
</div>

<!-- Give Comfort cross-sell -->
{% render 'give-comfort-strip' %}

<script>
  function ckSetMainImage(sid, url) {
    var el = document.getElementById('ck-main-img-' + sid);
    if (el) el.src = url;
  }
  function ckToggleGift(sid) {
    var cb = document.getElementById('ck-gift-toggle-' + sid);
    var note = document.getElementById('ck-gift-note-' + sid);
    if (note) note.style.display = cb.checked ? 'block' : 'none';
  }
  function ckSelectColor(sid, value) {
    var lbl = document.getElementById('ck-color-label-' + sid);
    if (lbl) lbl.textContent = value;
    document.querySelectorAll('.ck-swatch[data-value]').forEach(function(btn) {
      btn.style.borderColor = btn.dataset.value === value ? 'var(--ink)' : 'transparent';
    });
  }
  function ckSelectSize(sid, value) {
    document.querySelectorAll('.ck-size-pill[data-value]').forEach(function(btn) {
      btn.style.background = btn.dataset.value === value ? 'var(--ink)' : 'transparent';
      btn.style.color = btn.dataset.value === value ? 'var(--cream)' : 'var(--ink)';
    });
  }
</script>

{% schema %}
{
  "name": "Product Page",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "callout_1_label",
      "label": "Callout 1 label",
      "default": "The Heart"
    },
    {
      "type": "text",
      "id": "callout_1_heading",
      "label": "Callout 1 heading",
      "default": "Made for the hard days."
    },
    {
      "type": "textarea",
      "id": "callout_1_body",
      "label": "Callout 1 body",
      "default": "This hoodie started as a grief project. A thing to make when I did not know what else to do. The fabric was chosen because it felt like the closest thing to being held."
    },
    {
      "type": "image_picker",
      "id": "callout_1_image",
      "label": "Callout 1 image"
    },
    {
      "type": "text",
      "id": "callout_2_label",
      "label": "Callout 2 label",
      "default": "The Sleeve"
    },
    {
      "type": "text",
      "id": "callout_2_heading",
      "label": "Callout 2 heading",
      "default": "No drawstring. On purpose."
    },
    {
      "type": "textarea",
      "id": "callout_2_body",
      "label": "Callout 2 body",
      "default": "A drawstring is one more thing to fuss with on a day when you have no energy for fussing. We left it out intentionally."
    },
    {
      "type": "image_picker",
      "id": "callout_2_image",
      "label": "Callout 2 image"
    },
    {
      "type": "text",
      "id": "founder_quote",
      "label": "Founder quote",
      "default": "I made the thing I wished someone had sent me."
    }
  ],
  "presets": [
    {
      "name": "Product Page"
    }
  ]
}
{% endschema %}
