{% comment %}
  Comfort Kind — Main Product Section
  Wires directly into Shopify's native product form / cart AJAX API.
  Dawn's product-form snippet handles Add to Cart, variant selection,
  and cart drawer updates automatically.
{% endcomment %}

{%- assign product = product -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}

<section class="ck-product" id="ProductSection-{{ section.id }}">
  <div class="ck-product__inner">

    {%- comment -%} ── Left: Media Gallery ── {%- endcomment -%}
    <div class="ck-product__gallery" id="MediaGallery-{{ section.id }}">
      {%- for media in product.media -%}
        <div
          class="ck-product__media-item{% if media == featured_media %} ck-product__media-item--active{% endif %}"
          data-media-id="{{ media.id }}"
        >
          {%- if media.media_type == 'image' -%}
            {{
              media
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                class: 'ck-product__image',
                alt: media.alt | escape,
                widths: '550, 720, 990, 1200',
                sizes: '(min-width: 1200px) 550px, (min-width: 750px) calc(50vw - 2rem), 100vw'
            }}
          {%- elsif media.media_type == 'video' -%}
            {{
              media
              | video_tag:
                image_size: '1200x',
                autoplay: false,
                loop: false,
                controls: true,
                class: 'ck-product__video'
            }}
          {%- endif -%}
        </div>
      {%- endfor -%}

      {%- if product.media.size > 1 -%}
        <div class="ck-product__thumbnails">
          {%- for media in product.media -%}
            <button
              class="ck-product__thumb{% if media == featured_media %} ck-product__thumb--active{% endif %}"
              data-media-id="{{ media.id }}"
              aria-label="View image {{ forloop.index }}"
            >
              {{
                media.preview_image
                | image_url: width: 120
                | image_tag: loading: 'lazy', alt: media.alt | escape, class: 'ck-product__thumb-img'
              }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ── Right: Product Info + Form ── {%- endcomment -%}
    <div class="ck-product__info">

      {%- comment -%} Breadcrumb {%- endcomment -%}
      {%- if section.settings.show_breadcrumb -%}
        <nav class="ck-product__breadcrumb" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">Home</a>
          <span aria-hidden="true"> / </span>
          {%- if collection -%}
            <a href="{{ collection.url }}">{{ collection.title }}</a>
            <span aria-hidden="true"> / </span>
          {%- endif -%}
          <span aria-current="page">{{ product.title }}</span>
        </nav>
      {%- endif -%}

      {%- comment -%} Vendor {%- endcomment -%}
      {%- if section.settings.show_vendor and product.vendor != blank -%}
        <p class="ck-product__vendor">{{ product.vendor }}</p>
      {%- endif -%}

      {%- comment -%} Title {%- endcomment -%}
      <h1 class="ck-product__title">{{ product.title }}</h1>

      {%- comment -%} Price {%- endcomment -%}
      <div class="ck-product__price" id="price-{{ section.id }}" role="status">
        {%- render 'price', product: product, use_variant: true, show_badges: true -%}
      </div>

      {%- comment -%} Short description / tagline {%- endcomment -%}
      {%- if product.metafields.custom.tagline != blank -%}
        <p class="ck-product__tagline">{{ product.metafields.custom.tagline }}</p>
      {%- endif -%}

      {%- comment -%} ── PRODUCT FORM (Dawn native — handles cart, variants, quantity) ── {%- endcomment -%}
      {%- form 'product', product,
          id: 'product-form-' | append: section.id,
          class: 'ck-product__form',
          novalidate: 'novalidate',
          data-type: 'add-to-cart-form'
      -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" disabled>

        {%- comment -%} Variant Selectors {%- endcomment -%}
        {%- unless product.has_only_default_variant -%}
          <div class="ck-product__variants">
            {%- for option in product.options_with_values -%}
              <fieldset class="ck-product__option-fieldset">
                <legend class="ck-product__option-label">
                  {{ option.name }}
                  {%- if option.name == 'Size' -%}
                    {%- if section.settings.show_size_guide -%}
                      <button
                        type="button"
                        class="ck-product__size-guide-link"
                        aria-haspopup="dialog"
                      >
                        Size guide
                      </button>
                    {%- endif -%}
                  {%- endif -%}
                </legend>

                <div class="ck-product__option-values">
                  {%- for value in option.values -%}
                    {%- assign variant_option = 'option' | append: option.position -%}
                    {%- assign current_variant_check = product.variants
                      | where: variant_option, value
                      | first
                    -%}
                    <label
                      class="ck-product__option-label-btn{% if option.selected_value == value %} ck-product__option-label-btn--selected{% endif %}{% unless current_variant_check.available %} ck-product__option-label-btn--unavailable{% endunless %}"
                      for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                    >
                      <input
                        type="radio"
                        id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                        name="{{ option.name }}"
                        value="{{ value | escape }}"
                        form="product-form-{{ section.id }}"
                        {% if option.selected_value == value %}checked{% endif %}
                        class="ck-product__option-input"
                      >
                      {{ value }}
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        {%- comment -%} Quantity Selector {%- endcomment -%}
        {%- if section.settings.show_quantity_selector -%}
          <div class="ck-product__quantity">
            <label class="ck-product__quantity-label" for="Quantity-{{ section.id }}">
              Quantity
            </label>
            <div class="ck-product__quantity-wrapper">
              <button
                class="ck-product__quantity-btn"
                type="button"
                aria-label="Decrease quantity"
                data-action="decrease"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="2" viewBox="0 0 14 2"><path d="M1 1h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </button>
              <input
                class="ck-product__quantity-input"
                type="number"
                name="quantity"
                id="Quantity-{{ section.id }}"
                min="1"
                value="1"
                form="product-form-{{ section.id }}"
              >
              <button
                class="ck-product__quantity-btn"
                type="button"
                aria-label="Increase quantity"
                data-action="increase"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </button>
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} Add to Cart Button {%- endcomment -%}
        <div class="ck-product__atc-wrapper">
          <button
            type="submit"
            name="add"
            class="ck-product__atc-btn{% unless current_variant.available %} ck-product__atc-btn--disabled{% endunless %}"
            {% unless current_variant.available %}disabled{% endunless %}
            aria-label="{{ 'products.product.add_to_cart' | t }}"
          >
            <span class="ck-product__atc-btn-text">
              {%- if current_variant.available -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </span>
            <span class="ck-product__atc-btn-loading" hidden>
              <svg class="ck-spinner" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" opacity="0.25"/>
                <path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </span>
          </button>

          {%- if section.settings.show_dynamic_checkout -%}
            {{ form | payment_button }}
          {%- endif -%}
        </div>

        {%- comment -%} Error message container {%- endcomment -%}
        <div class="ck-product__error" id="product-error-{{ section.id }}" role="alert" hidden></div>

      {%- endform -%}

      {%- comment -%} ── Product Details (accordion) ── {%- endcomment -%}
      <div class="ck-product__details">

        {%- if product.description != blank -%}
          <details class="ck-accordion" open>
            <summary class="ck-accordion__header">
              <span>The details</span>
              <svg class="ck-accordion__icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="ck-accordion__body">
              {{ product.description }}
            </div>
          </details>
        {%- endif -%}

        {%- if section.settings.show_fabric_care -%}
          <details class="ck-accordion">
            <summary class="ck-accordion__header">
              <span>Fabric &amp; care</span>
              <svg class="ck-accordion__icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="ck-accordion__body">
              {{ section.settings.fabric_care_text }}
            </div>
          </details>
        {%- endif -%}

        {%- if section.settings.show_give_comfort -%}
          <details class="ck-accordion">
            <summary class="ck-accordion__header">
              <span>Give Comfort — send as a gift</span>
              <svg class="ck-accordion__icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="ck-accordion__body">
              <p>{{ section.settings.give_comfort_text }}</p>
              {%- if section.settings.give_comfort_url != blank -%}
                <a href="{{ section.settings.give_comfort_url }}" class="ck-product__give-comfort-link">
                  Send as a gift →
                </a>
              {%- endif -%}
            </div>
          </details>
        {%- endif -%}

      </div>

      {%- comment -%} Trust badges {%- endcomment -%}
      {%- if section.settings.show_trust_badges -%}
        <div class="ck-product__trust">
          <span class="ck-product__trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
            30-Day Guarantee
          </span>
          <span class="ck-product__trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/></svg>
            Free Shipping $75+
          </span>
          <span class="ck-product__trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>
            Comfort Certified
          </span>
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Display options"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quantity_selector",
      "label": "Show quantity selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout buttons",
      "info": "Using the payment methods available on your store, customers see their preferred option, like PayPal or Apple Pay.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_size_guide",
      "label": "Show size guide link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_trust_badges",
      "label": "Show trust badges",
      "default": true
    },
    {
      "type": "header",
      "content": "Fabric & care tab"
    },
    {
      "type": "checkbox",
      "id": "show_fabric_care",
      "label": "Show fabric & care accordion",
      "default": true
    },
    {
      "type": "richtext",
      "id": "fabric_care_text",
      "label": "Fabric & care content",
      "default": "<p>8.9 oz heavyweight fleece — 80% organic combed ring-spun cotton, 20% recycled polyester. Cold wash inside-out, tumble dry low or lay flat.</p>"
    },
    {
      "type": "header",
      "content": "Give Comfort tab"
    },
    {
      "type": "checkbox",
      "id": "show_give_comfort",
      "label": "Show Give Comfort accordion",
      "default": true
    },
    {
      "type": "richtext",
      "id": "give_comfort_text",
      "label": "Give Comfort description",
      "default": "<p>Send softness straight to someone holding a lot — no price, no packing slip. Ships directly to them with a handwritten card.</p>"
    },
    {
      "type": "url",
      "id": "give_comfort_url",
      "label": "Give Comfort page URL"
    }
  ],
  "presets": [
    {
      "name": "Product information"
    }
  ]
}
{% endschema %}
