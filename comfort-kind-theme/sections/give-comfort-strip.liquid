<section class="ck-give">
  <div style="max-width:720px;margin:0 auto;padding:0 32px;">
    <div class="eyebrow" style="display:flex;align-items:center;justify-content:center;gap:8px;">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402 0-3.791 3.068-5.191 5.281-5.191 1.312 0 4.151.501 5.719 4.457 1.59-3.968 4.464-4.447 5.726-4.447 2.54 0 5.274 1.621 5.274 5.181 0 4.069-5.136 8.625-11 14.402z"/>
      </svg>
      Give Comfort
    </div>
    <h2>{{ section.settings.heading_1 }}<br><em>{{ section.settings.heading_2 }}</em></h2>
    {%- if section.settings.body != blank -%}
      <p>{{ section.settings.body }}</p>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_url }}" class="ck-btn ck-btn--primary">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Give Comfort Strip",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading_1",
      "label": "Heading line 1",
      "default": "A hoodie you buy for yourself."
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Heading line 2 (italic)",
      "default": "A hoodie you send to someone who needs it."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Add a private gift note at checkout. Have it shipped straight to them. No pricing, no packing slip. Just something soft, arriving when the day was hard."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Send as a Gift"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    }
  ],
  "presets": [
    {
      "name": "Give Comfort Strip"
    }
  ]
}
{% endschema %}
