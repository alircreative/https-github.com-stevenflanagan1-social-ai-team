<section class="ck-signoff">
  <div class="ck-signoff__img" style="{%- if section.settings.image != blank -%}background-image:url('{{ section.settings.image | image_url: width: 1000 }}');background-size:cover;background-position:center;{%- endif -%}"></div>
  <div class="ck-signoff__body">
    {%- if section.settings.eyebrow != blank -%}
      <div class="eyebrow" style="display:flex;align-items:center;gap:8px;">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" style="color:var(--taupe-dark);">
          <path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402 0-3.791 3.068-5.191 5.281-5.191 1.312 0 4.151.501 5.719 4.457 1.59-3.968 4.464-4.447 5.726-4.447 2.54 0 5.274 1.621 5.274 5.181 0 4.069-5.136 8.625-11 14.402z"/>
        </svg>
        {{ section.settings.eyebrow }}
      </div>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <p class="ck-signoff__note">{{ section.settings.body }}</p>
    {%- endif -%}
    <div class="ck-signoff__sig">
      {{ section.settings.sig_name }}<small>{{ section.settings.sig_title }}</small>
    </div>
    <div class="ck-signoff__rule"></div>
    <div class="ck-signoff__letters">
      {%- if section.settings.letters_eyebrow != blank -%}
        <div class="eyebrow">{{ section.settings.letters_eyebrow }}</div>
      {%- endif -%}
      {%- if section.settings.letters_heading != blank -%}
        <h3>{{ section.settings.letters_heading }}</h3>
      {%- endif -%}
      {%- if section.settings.letters_body != blank -%}
        <p>{{ section.settings.letters_body }}</p>
      {%- endif -%}
      <div class="form">
        {%- form 'customer', id: 'signoff-newsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" placeholder="Your email address" autocomplete="email" required>
          <button type="submit">Join</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Founder Sign-off",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A note from Ali"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "I made the thing I wished someone had sent me."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "ComfortKind started in a hard season of my own. Every piece leaves here the way I'd send it to a friend - soft, considered, with a heart stitched where you can feel it. If one of these found you at the right moment, that was the whole point."
    },
    {
      "type": "text",
      "id": "sig_name",
      "label": "Signature name",
      "default": "Ali"
    },
    {
      "type": "text",
      "id": "sig_title",
      "label": "Signature title",
      "default": "Founder, ComfortKind"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Founder image"
    },
    {
      "type": "text",
      "id": "letters_eyebrow",
      "label": "Letters eyebrow",
      "default": "Letters from Ali"
    },
    {
      "type": "text",
      "id": "letters_heading",
      "label": "Letters heading",
      "default": "A short note, once a month."
    },
    {
      "type": "textarea",
      "id": "letters_body",
      "label": "Letters body",
      "default": "New pieces, the people wearing them, what I'm thinking about. No noise, no urgency - you can leave whenever you like."
    }
  ],
  "presets": [
    {
      "name": "Founder Sign-off"
    }
  ]
}
{% endschema %}
