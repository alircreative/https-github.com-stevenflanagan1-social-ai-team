<footer class="ck-footer">
  <div class="ck-footer__inner">
    <div class="ck-footer__grid">

      <div class="ck-footer__brand">
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: 200
            | image_tag: loading: 'lazy', alt: shop.name, class: 'ck-footer__logo-img'
          }}
        {%- else -%}
          <p class="ck-footer__brand-name">{{ shop.name }}</p>
        {%- endif -%}
        {%- if section.settings.tagline != blank -%}
          <p class="ck-footer__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}
          <div class="ck-footer__col" {{ block.shopify_attributes }}>
            <p class="ck-footer__col-heading">{{ block.settings.heading }}</p>
            {%- if block.settings.menu != blank -%}
              <ul class="ck-footer__links">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

    </div>

    <div class="ck-footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
      {%- if shop.powered_by_link -%}
        <span>{{ powered_by_link }}</span>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "blocks": [
    {
      "type": "link_list",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Comfort for hard days — and all the days in between."
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "link_list", "settings": { "heading": "Shop", "menu": "main-menu" } },
        { "type": "link_list", "settings": { "heading": "Help", "menu": "footer" } }
      ]
    }
  ]
}
{% endschema %}
