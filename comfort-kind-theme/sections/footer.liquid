<footer class="ck-footer">
  <div class="top">
    <div class="col">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 160 | image_tag: loading: 'lazy', alt: shop.name }}
      {%- else -%}
        <span style="font-family:'Cormorant Garamond',serif;font-size:20px;color:var(--cream);font-weight:400;">{{ shop.name }}</span>
      {%- endif -%}
      <p class="brand-blurb">{{ section.settings.blurb }}</p>
    </div>
    <div class="col">
      <h4>Shop</h4>
      {%- for link in section.settings.menu_shop.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </div>
    <div class="col">
      <h4>About</h4>
      {%- for link in section.settings.menu_about.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </div>
    <div class="col">
      <h4>Letters from Ali</h4>
      <p>{{ section.settings.newsletter_blurb }}</p>
      {%- form 'customer', id: 'footer-newsletter' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div style="display:flex;border-bottom:1px solid rgba(245,240,234,0.4);padding-bottom:4px;margin-top:8px;">
          <input type="email" name="contact[email]" placeholder="Your email" autocomplete="email" required
            style="flex:1;background:transparent;border:none;outline:none;font-family:'Jost',sans-serif;font-size:14px;color:var(--cream);padding:10px 0;">
          <button type="submit"
            style="background:none;border:none;cursor:pointer;color:var(--cream);font-size:11px;letter-spacing:0.18em;text-transform:uppercase;padding:10px 0 10px 14px;white-space:nowrap;opacity:0.85;">
            Join
          </button>
        </div>
      {%- endform -%}
    </div>
  </div>
  <div class="bottom">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
    <span>
      <a href="/policies/privacy-policy" style="color:inherit;opacity:0.5;text-decoration:none;">Privacy</a>
      &nbsp;&middot;&nbsp;
      <a href="/policies/terms-of-service" style="color:inherit;opacity:0.5;text-decoration:none;">Terms</a>
      &nbsp;&middot;&nbsp;
      <a href="/pages/accessibility" style="color:inherit;opacity:0.5;text-decoration:none;">Accessibility</a>
    </span>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Brand blurb",
      "default": "Made by Ali. From a hospital waiting room, for anyone holding the weight of a hard season."
    },
    {
      "type": "link_list",
      "id": "menu_shop",
      "label": "Shop menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "menu_about",
      "label": "About menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "newsletter_blurb",
      "label": "Newsletter blurb",
      "default": "A few words, once a month. No noise."
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
