<div class="ck-faq">
  <div class="ck-faq__hero">
    <div class="ck-faq__hero-inner">
      <h1 class="ck-faq__title">{{ section.settings.title | default: 'Questions, answered.' }}</h1>
      {% if section.settings.subtitle != blank %}
        <p class="ck-faq__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>
  </div>

  {% if section.blocks.size > 0 %}
    <div class="ck-faq__tabs" role="tablist" id="ck-faq-tabs">
      {% for block in section.blocks %}
        {% if block.type == 'category' %}
          <button
            class="ck-faq__tab{% if forloop.first %} is-active{% endif %}"
            role="tab"
            data-target="ck-faq-panel-{{ forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            type="button"
            {{ block.shopify_attributes }}
          >{{ block.settings.title }}</button>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ck-faq__content">
      {% for block in section.blocks %}
        {% if block.type == 'category' %}
          <div
            class="ck-faq__panel{% if forloop.first %} is-active{% endif %}"
            id="ck-faq-panel-{{ forloop.index }}"
            role="tabpanel"
          >
            {{ block.settings.content }}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}

  {% if section.settings.footer_text != blank %}
    <div class="ck-faq__footer">
      <p class="ck-faq__footer-text">{{ section.settings.footer_text }}</p>
      {% if section.settings.contact_label != blank %}
        <a href="{{ section.settings.contact_url }}" class="ck-btn ck-btn--secondary">
          {{ section.settings.contact_label }}
        </a>
      {% endif %}
    </div>
  {% endif %}
</div>

<script>
(function() {
  var tabs = document.querySelectorAll('.ck-faq__tab');
  var panels = document.querySelectorAll('.ck-faq__panel');

  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      tabs.forEach(function(t) {
        t.classList.remove('is-active');
        t.setAttribute('aria-selected', 'false');
      });
      panels.forEach(function(p) { p.classList.remove('is-active'); });

      this.classList.add('is-active');
      this.setAttribute('aria-selected', 'true');
      var target = document.getElementById(this.dataset.target);
      if (target) target.classList.add('is-active');
    });
  });

  // FAQ accordion within panels
  document.querySelectorAll('.ck-faq__entry').forEach(function(entry) {
    var btn = entry.querySelector('.ck-faq__q');
    if (btn) {
      btn.addEventListener('click', function() {
        entry.classList.toggle('is-open');
      });
    }
  });
})();
</script>

{% schema %}
{
  "name": "FAQ Page",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Page title",
      "default": "Questions, answered."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Everything you need to know about ComfortKind."
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer text",
      "default": "Still have questions? We'd love to hear from you."
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact button label",
      "default": "Get in touch"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact URL"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "FAQ Category",
      "settings": [
        {
