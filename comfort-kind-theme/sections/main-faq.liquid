{% comment %} FAQ page {% endcomment %}

<div class="ck-faq">
  <div class="ck-faq__inner">

    <div class="ck-faq__header">
      <h1 class="ck-faq__title">{{ section.settings.title }}</h1>
      <p class="ck-faq__subtitle">{{ section.settings.subtitle }}</p>
    </div>

    {%- comment -%} Category tabs {%- endcomment -%}
    <div class="ck-faq__tabs" role="tablist">
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          <button
            class="ck-faq__tab{% if forloop.first %} ck-faq__tab--active{% endif %}"
            data-tab="faq-cat-{{ forloop.index }}"
            role="tab"
            {{ block.shopify_attributes }}
          >
            <span class="ck-faq__tab-num">{{ block.settings.number }}</span>
            {{ block.settings.title }}
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} FAQ content panels {%- endcomment -%}
    <div class="ck-faq__panels">
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          <div
            class="ck-faq__panel{% if forloop.first %} ck-faq__panel--active{% endif %}"
            id="faq-cat-{{ forloop.index }}"
            role="tabpanel"
          >
            {{ block.settings.content }}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} Still have questions {%- endcomment -%}
    <div class="ck-faq__footer">
      <p class="ck-faq__footer-text">{{ section.settings.footer_text }}</p>
      {%- if section.settings.contact_label != blank -%}
        <a href="{{ section.settings.contact_url }}" class="ck-btn ck-btn--outline">{{ section.settings.contact_label }}</a>
      {%- endif -%}
    </div>

  </div>
</div>

<script>
  document.querySelectorAll('.ck-faq__tab').forEach(function(tab) {
    tab.addEventListener('click', function() {
      var target = this.dataset.tab;
      document.querySelectorAll('.ck-faq__tab').forEach(function(t) { t.classList.remove('ck-faq__tab--active'); });
      document.querySelectorAll('.ck-faq__panel').forEach(function(p) { p.classList.remove('ck-faq__panel--active'); });
      this.classList.add('ck-faq__tab--active');
      document.getElementById(target).classList.add('ck-faq__panel--active');
    });
  });
</script>

{% schema %}
{
  "name": "FAQ Page",
  "blocks": [
    {
      "type": "category",
      "name": "FAQ Category",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "01" },
        { "type": "text", "id": "title", "label": "Category title", "default": "Sizing & fit" },
        { "type": "richtext", "id": "content", "label": "Questions and answers" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "title", "label": "Page title", "default": "Questions, answered." },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Everything you might wonder about sizing, fabric, gifting, and getting your order - written by me, in plain words." },
    { "type": "text", "id": "footer_text", "label": "Footer text", "default": "If something's still on your mind, you can always reach me directly." },
    { "type": "text", "id": "contact_label", "label": "Contact button label", "default": "Get in touch" },
    { "type": "url", "id": "contact_url", "label": "Contact URL" }
  ],
  "presets": [
    {
      "name": "FAQ Page",
      "blocks": [
        { "type": "category", "settings": { "number": "01", "title": "Sizing & fit", "content": "<p><strong>How does it fit?</strong><br>Relaxed and waist-length, with dropped shoulders - easy to layer, easy to live in.</p><p><strong>I'm between sizes. Up or down?</strong><br>Size up. This is a piece you reach for on the soft days, and a little extra room only makes it more of a hug.</p><p><strong>Do the hoodie and crewneck fit the same?</strong><br>Yes. Same pattern, same fabric, same proportions - the crewneck is simply the hoodie without the hood.</p><p><strong>Is there a size guide?</strong><br>There is, on every product page, with flat measurements for each size.</p>" } },
        { "type": "category", "settings": { "number": "02", "title": "Fabric & care", "content": "<p><strong>What's it made of?</strong><br>8.9 oz heavyweight fleece - 80% organic combed ring-spun cotton, 20% recycled polyester.</p><p><strong>Is it really organic?</strong><br>Yes, and independently verified. We carry GOTS, OCS, and GRS certifications.</p><p><strong>Why no drawstring?</strong><br>On purpose. A drawstring is one more thing to fuss with on a day you don't have the energy for fussing.</p><p><strong>How do I care for it?</strong><br>Cold wash, inside-out. Tumble dry low or lay it flat.</p>" } },
        { "type": "category", "settings": { "number": "03", "title": "Give Comfort", "content": "<p><strong>How does Give Comfort work?</strong><br>At checkout, choose the hoodie or the crewneck, write a few words, and add their address. We ship it directly to them with a hand-written card.</p><p><strong>Will they see the price?</strong><br>Never. No pricing, no invoice, no packing slip travels with a Give Comfort order.</p><p><strong>Can I stay anonymous?</strong><br>You can. Sign the note however you like, or leave it unsigned.</p><p><strong>Can you ship to a hospital?</strong><br>Yes. Add the room or unit details in the address and we'll get it there.</p>" } },
        { "type": "category", "settings": { "number": "04", "title": "Orders & shipping", "content": "<p><strong>When will my order ship?</strong><br>Most orders ship within 2 business days.</p><p><strong>Is shipping free?</strong><br>Free on orders over $75 in the US. Flat rate for orders under that.</p><p><strong>Do you ship internationally?</strong><br>Yes, to most countries. Duties and taxes are shown at checkout.</p><p><strong>Can I change my address?</strong><br>Yes, if your order hasn't shipped yet. Email me right away.</p>" } },
        { "type": "category", "settings": { "number": "05", "title": "Returns & guarantee", "content": "<p><strong>What is the 30-Day Comfort Guarantee?</strong><br>If it doesn't feel right, return it within 30 days. No questions asked, no restocking fee.</p><p><strong>How do I start a return?</strong><br>Email me directly and I'll take care of it.</p><p>Comfort you have to argue for isn't comfort.</p>" } }
      ]
    }
  ]
}
{% endschema %}
