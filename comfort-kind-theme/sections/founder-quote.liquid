<section class="ck-quote-block">
  <div class="ck-quote-block__inner">
    {% if section.settings.quote != blank %}
      <blockquote class="ck-quote-block__text">"{{ section.settings.quote }}"</blockquote>
    {% endif %}
    {% if section.settings.attribution != blank %}
      <p class="ck-quote-block__attr">{{ section.settings.attribution }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Founder Quote",
  "tag": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "I didn't set out to build a brand. I made this for the hard days. Mine first. Then everyone else's."
    },
    {
      "type": "text",
      "id": "attribution",
      "label": "Attribution",
      "default": "Ali, Founder - ComfortKind"
    }
  ],
  "presets": [
    {
      "name": "Founder Quote"
    }
  ]
}
{% endschema %}
